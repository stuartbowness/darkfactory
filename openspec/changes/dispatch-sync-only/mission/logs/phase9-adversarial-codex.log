"thread.started should parse\");\n  1027\t\n  1028\t        assert_eq!(event.session_id.as_deref(), Some(\"test-abc-123\"));\n  1029\t    }\n  1030\t\n  1031\t    #[test]\n  1032\t    fn parse_codex_event_extracts_tool_names() {\n  1033\t        let started = parse_codex_event(\n  1034\t            r#\"{\"type\":\"item.started\",\"item\":{\"type\":\"tool_use\",\"name\":\"shell\"}}\"#,\n  1035\t        )\n  1036\t        .expect(\"item.started tool_use should parse\");\n  1037\t        let completed = parse_codex_event(\n  1038\t            r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"tool_use\",\"name\":\"shell\"}}\"#,\n  1039\t        )\n  1040\t        .expect(\"item.completed tool_use should parse\");\n  1041\t\n  1042\t        assert_eq!(started.tool.as_deref(), Some(\"shell\"));\n  1043\t        assert_eq!(completed.tool.as_deref(), Some(\"shell\"));\n  1044\t    }\n  1045\t\n  1046\t    #[test]\n  1047\t    fn parse_codex_event_extracts_commands() {\n  1048\t        let started = parse_codex_event(\n  1049\t            r#\"{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\",\"command\":\"cargo test\"}}\"#,\n  1050\t        )\n  1051\t        .expect(\"command_execution start should parse\");\n  1052\t        let completed = parse_codex_event(\n  1053\t            r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\",\"command\":\"cargo test\"}}\"#,\n  1054\t        )\n  1055\t        .expect(\"command_execution completion should parse\");\n  1056\t\n  1057\t        assert_eq!(started.command.as_deref(), Some(\"cargo test\"));\n  1058\t        assert_eq!(completed.command.as_deref(), Some(\"cargo test\"));\n  1059\t    }\n  1060\t\n  1061\t    #[test]\n  1062\t    fn parse_codex_event_extracts_response_and_error_text() {\n  1063\t        let response = parse_codex_event(\n  1064\t            r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"I created the file.\"}}\"#,\n  1065\t        )\n  1066\t        .expect(\"agent_message should parse\");\n  1067\t        let failed =\n  1068\t            parse_codex_event(r#\"{\"type\":\"turn.failed\",\"error\":{\"message\":\"rate limited\"}}\"#)\n  1069\t                .expect(\"turn.failed should parse\");\n  1070\t        let error = parse_codex_event(r#\"{\"type\":\"error\",\"error\":{\"message\":\"connection reset\"}}\"#)\n  1071\t            .expect(\"error should parse\");\n  1072\t\n  1073\t        assert_eq!(response.text.as_deref(), Some(\"I created the file.\"));\n  1074\t        assert_eq!(failed.text.as_deref(), Some(\"rate limited\"));\n  1075\t        assert_eq!(error.text.as_deref(), Some(\"connection reset\"));\n  1076\t    }\n  1077\t\n  1078\t    #[test]\n  1079\t    fn parse_codex_event_extracts_file_paths() {\n  1080\t        let write = parse_codex_event(\n  1081\t            r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"tool_use\",\"name\":\"write\",\"file_path\":\"src/main.rs\"}}\"#,\n  1082\t        )\n  1083\t        .expect(\"file write should parse\");\n  1084\t        let read = parse_codex_event(\n  1085\t            r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"tool_use\",\"name\":\"read\",\"file_path\":\"Cargo.toml\"}}\"#,\n  1086\t        )\n  1087\t        .expect(\"file read should parse\");\n  1088\t\n  1089\t        assert_eq!(write.file.as_deref(), Some(\"src/main.rs\"));\n  1090\t        assert_eq!(read.file.as_deref(), Some(\"Cargo.toml\"));\n  1091\t    }\n  1092\t\n  1093\t    #[test]\n  1094\t    fn parse_codex_event_extracts_token_counts() {\n  1095\t        let event = parse_codex_event(\n  1096\t            r#\"{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":100,\"output_tokens\":50,\"reasoning_tokens\":20}}\"#,\n  1097\t        )\n  1098\t        .expect(\"turn.completed should parse\");\n  1099\t        let tokens = event.tokens.expect(\"turn.completed should include tokens\");\n  1100\t\n  1101\t        assert_eq!(\n  1102\t          