om_utf8(buffer.lock().expect(\"shared buffer mutex poisoned\").clone())\n   248\t                .expect(\"events are utf8\");\n   249\t\n   250\t        output\n   251\t            .lines()\n   252\t            .map(|line| serde_json::from_str(line).expect(\"event line is valid json\"))\n   253\t            .collect()\n   254\t    }\n   255\t\n   256\t    #[test]\n   257\t    fn heartbeat_event_format() {\n   258\t        let (emitter, buffer) = emitter_with_buffer();\n   259\t\n   260\t        emitter\n   261\t            .emit_heartbeat_with_interval(\"running: cargo test\", 15)\n   262\t            .expect(\"emit heartbeat\");\n   263\t\n   264\t        let events = buffer_lines(&buffer);\n   265\t        assert_eq!(events.len(), 1);\n   266\t        assert_eq!(events[0][\"type\"], \"heartbeat\");\n   267\t        assert_eq!(events[0][\"dispatch_id\"], \"dispatch-123\");\n   268\t        assert!(events[0][\"ts\"].as_str().is_some());\n   269\t        assert!(events[0][\"elapsed_s\"].as_u64().is_some());\n   270\t        assert_eq!(events[0][\"last_activity\"], \"running: cargo test\");\n   271\t        assert!(events[0][\"interval_s\"].as_u64().is_some());\n   272\t    }\n   273\t\n   274\t    #[test]\n   275\t    fn event_type_coverage() {\n   276\t        let (emitter, buffer) = emitter_with_buffer();\n   277\t\n   278\t        emitter\n   279\t            .emit_dispatch_start(\"codex\", \"gpt-5.5\")\n   280\t            .expect(\"emit dispatch start\");\n   281\t        emitter\n   282\t            .emit_dispatch_end(\"completed\", 123)\n   283\t            .expect(\"emit dispatch end\");\n   284\t        emitter\n   285\t            .emit_heartbeat_with_interval(\"running\", 15)\n   286\t            .expect(\"emit heartbeat\");\n   287\t        emitter\n   288\t            .emit_timeout_warning()\n   289\t            .expect(\"emit timeout warning\");\n   290\t        emitter.emit_tool_start(\"shell\").expect(\"emit tool start\");\n   291\t        emitter.emit_tool_end(\"shell\").expect(\"emit tool end\");\n   292\t        emitter\n   293\t            .emit_file_write(\"src/main.rs\")\n   294\t            .expect(\"emit file write\");\n   295\t        emitter.emit_file_read(\"README.md\").expect(\"emit file read\");\n   296\t        emitter\n   297\t            .emit_command_run(\"cargo test\")\n   298\t            .expect(\"emit command run\");\n   299\t        emitter\n   300\t            .emit_error(\"process_failed\", \"child exited\")\n   301\t            .expect(\"emit error\");\n   302\t\n   303\t        let event_types = buffer_lines(&buffer)\n   304\t            .iter()\n   305\t            .map(|event| {\n   306\t                event[\"type\"]\n   307\t                    .as_str()\n   308\t                    .expect(\"type is a string\")\n   309\t                    .to_string()\n   310\t            })\n   311\t            .collect::<Vec<_>>();\n   312\t\n   313\t        assert_eq!(\n   314\t            event_types,\n   315\t            vec![\n   316\t                \"dispatch_start\",\n   317\t                \"dispatch_end\",\n   318\t                \"heartbeat\",\n   319\t                \"timeout_warning\",\n   320\t                \"tool_start\",\n   321\t                \"tool_end\",\n   322\t                \"file_write\",\n   323\t                \"file_read\",\n   324\t                \"command_run\",\n   325\t                \"error\",\n   326\t            ]\n   327\t        );\n   328\t    }\n   329\t}\n","exit_code":0,"status":"completed"}}
