&pid_file);\n   408\t\n   409\t    let result = engine::dispatch(\n   410\t        spec(&tmp, &output, None, 1, 5),\n   411\t        \"dispatch-term-clean\".to_string(),\n   412\t        emitter(\"dispatch-term-clean\").0,\n   413\t    )\n   414\t    .await?;\n   415\t\n   416\t    std::env::remove_var(\"CODEX_MOCK_PID_FILE\");\n   417\t    assert_eq!(result.status, DispatchStatus::TimedOut);\n   418\t\n   419\t    let pid = std::fs::read_to_string(pid_file)?.trim().parse::<i32>()?;\n   420\t    assert_process_exits(pid).await?;\n   421\t\n   422\t    Ok(())\n   423\t}\n   424\t\n   425\t#[tokio::test(flavor = \"multi_thread\")]\n   426\tasync fn custom_heartbeat_interval_controls_heartbeat_rate(\n   427\t) -> Result<(), Box<dyn std::error::Error>> {\n   428\t    let _path_guard = TestPath::install(\"delayed_success_5\").await?;\n   429\t    let tmp = temp_test_dir(\"custom-heartbeat\")?;\n   430\t    let output = tmp.join(\"result.md\");\n   431\t    let (emitter, buffer) = emitter(\"dispatch-custom-heartbeat\");\n   432\t    let mut dispatch_spec = spec(&tmp, &output, None, 10, 0);\n   433\t    dispatch_spec.heartbeat_sec = 2;\n   434\t\n   435\t    let result = engine::dispatch(\n   436\t        dispatch_spec,\n   437\t        \"dispatch-custom-heartbeat\".to_string(),\n   438\t        emitter,\n   439\t    )\n   440\t    .await?;\n   441\t\n   442\t    assert_eq!(result.status, DispatchStatus::Completed);\n   443\t    let events = buffer_events(&buffer)?;\n   444\t    let heartbeats = events\n   445\t        .iter()\n   446\t        .filter(|event| event[\"type\"] == \"heartbeat\")\n   447\t        .collect::<Vec<_>>();\n   448\t    assert!(heartbeats.len() >= 2, \"events: {events:?}\");\n   449\t    assert!(heartbeats\n   450\t        .iter()\n   451\t        .all(|event| event[\"interval_s\"].as_u64() == Some(2)));\n   452\t\n   453\t    Ok(())\n   454\t}\n   455\t\n   456\tfn emitter(dispatch_id: &str) -> (Arc<Emitter>, Arc<Mutex<Vec<u8>>>) {\n   457\t    let