: Option<String>,\n   510\t    previous_mode: Option<String>,\n   511\t}\n   512\t\n   513\timpl TestPath {\n   514\t    async fn install(mode: &str) -> Result<Self, Box<dyn std::error::Error>> {\n   515\t        Self::install_script(\"test_codex_mock.sh\", Some(mode)).await\n   516\t    }\n   517\t\n   518\t    async fn install_script(\n   519\t        source_name: &str,\n   520\t        mode: Option<&str>,\n   521\t    ) -> Result<Self, Box<dyn std::error::Error>> {\n   522\t        let guard = PATH_LOCK.lock().await;\n   523\t        let bin_dir = temp_test_dir(\"bin\")?;\n   524\t        let source = Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n   525\t            .join(\"tests\")\n   526\t            .join(source_name);\n   527\t        let target = bin_dir.join(\"codex\");\n   528\t        std::fs::copy(source, &target)?;\n   529\t\n   530\t        let previous_path = std::env::var(\"PATH\").ok();\n   531\t        let previous_mode = std::env::var(\"CODEX_MOCK_MODE\").ok();\n   532\t        let path = previous_path.clone().unwrap_or_default();\n   533\t        std::env::set_var(\"PATH\", format!(\"{}:{path}\", bin_dir.display()));\n   534\t        match mode {\n   535\t            Some(mode) => std::env::set_var(\"CODEX_MOCK_MODE\", mode),\n   536\t            None => std::env::remove_var(\"CODEX_MOCK_MODE\"),\n   537\t        }\n   538\t\n   539\t        Ok(Self {\n   540\t            _guard: guard,\n   541\t            previous_path,\n   542\t            previous_mode,\n   543\t        })\n   544\t    }\n   545\t\n   546\t    async fn missing_binary() -> Result<Self, Box<dyn std::error::Error>> {\n   547\t        let guard = PATH_LOCK.lock().await;\n   548\t        let bin_dir = temp_test_dir(\"empty-bin\")?;\n   549\t\n   550\t        let previous_path = std::env::var(\"PATH\").ok();\n   551\t        let previous_mode = std::env::var(\"CODEX_MOCK_MODE\").ok();\n   552\t        std::env::set_var(\"PATH\", bin_dir);\n   553\t        std::env::remove_var(\"CODEX_MOCK_MODE\");\n   554\t\n   555\t        Ok(Self {\n   556\t            _guard: guard,\n   557\t            previous_path,\n   558\t            previous_mode,\n   559\t        })\n   560\t    }\n   561\t}\n   562\t\n   563\timpl Drop for TestPath {\n   564\t    fn drop(&mut self) {\n   565\t        match &self.previous_path {\n   566\t            Some(path) => std::env::set_var(\"PATH\", path),\n   567\t            None => std::env::remove_var(\"PATH\"),\n   568\t        }\n   569\t        match &self.previous_mode {\n   570\t            Some(mode) => std::env::set_var(\"CODEX_MOCK_MODE\", mode),\n   571\t            None => std::env::remove_var(\"CODEX_MOCK_MODE\"),\n   572\t        }\n   573\t        std::env::remove_var(\"CODEX_MOCK_PID_FILE\");\n   574\t    }\n   575\t}\n   576\t\n   577\tasync fn assert_process_exits(pid: i32) -> Result<(), Box<dyn std::error::Error>> {\n   578\t    for _ in 0..40 {\n   579\t        if !process_exists(pid) {\n   580\t            return Ok(());\n   581\t        }\n   582\t        tokio::time::sleep(Duration::from_millis(50)).await;\n   583\t    }\n   584\t\n   585\t    Err(format!(\"process {pid} still exists\").into())\n   586\t}\n   587\t\n   588\tfn process_exists(pid: i32) -> bool {\n   589\t    let rc = unsafe { libc::kill(pid, 0) };\n   590\t    if rc == 0 {\n   591\t        return true;\n   592\t    }\n   593\t\n   594\t    io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)\n   595\t}\n","exit_code":0,"status":"completed"}}
