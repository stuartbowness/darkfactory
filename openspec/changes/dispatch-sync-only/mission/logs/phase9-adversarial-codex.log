        );\n   123\t        assert!(\n   124\t            !stderr.contains(\"dispatch not found\"),\n   125\t            \"{subcommand}: {stderr}\"\n   126\t        );\n   127\t        assert!(result.stdout.is_empty(), \"{subcommand}\");\n   128\t    }\n   129\t\n   130\t    Ok(())\n   131\t}\n   132\t\n   133\t#[test]\n   134\tfn json_stdout_is_single_object() -> Result<(), Box<dyn std::error::Error>> {\n   135\t    let env = MockEnv::new(\"json-single-object\")?;\n   136\t    let output = env.home.join(\"result.md\");\n   137\t    let result = env\n   138\t        .dispatch_command()\n   139\t        .args([\n   140\t            \"--json\",\n   141\t            \"--prompt\",\n   142\t            \"review\",\n   143\t            \"--output\",\n   144\t            output.to_str().expect(\"utf-8 output path\"),\n   145\t            \"--cwd\",\n   146\t            env.home.to_str().expect(\"utf-8 home path\"),\n   147\t        ])\n   148\t        .env(\"CODEX_MOCK_MODE\", \"special_chars\")\n   149\t        .output()?;\n   150\t\n   151\t    assert!(result.status.success(), \"stderr: {:?}\", result.stderr);\n   152\t    // Stdout must be exactly one parseable DispatchResult object -- no event or\n   153\t    // diagnostic leakage -- and special characters must round-trip through serde.\n   154\t    let parsed: Value = serde_json::from_slice(&result.stdout)?;\n   155\t    assert_eq!(parsed[\"status\"], \"completed\");\n   156\t    let commands = parsed[\"activity\"][\"commands_run\"]\n   157\t        .as_array()\n   158\t        .expect(\"commands_run array\");\n   159\t    assert_eq!(commands.len(), 1);\n   160\t    assert_eq!(commands[0], r#\"grep -n \"foo\\bar\" baz | jq .x\"#);\n   161\t\n   162\t    Ok(())\n   163\t}\n   164\t\n   165\t#[test]\n   166\tfn json_dispatch_without_store_paths_creates_no_dispatch_files(\n   167\t) -> Result<(), Box<dyn std::error::Error>> {\n   168\t    let _guard = STORE_PATH_LOCK.lock().expect(\"store path mutex poisoned\");\n   169\t    let env = MockEnv::new(\"no-store-files\")?;\n   170\t    let tmp_store = tmp_dispatch_root();\n   171\t    std::fs::remove_dir_all(&tmp_store).ok();\n   172\t    std::fs::remove_dir_all(home_dispatch_root(&env.home)).ok();\n   173\t\n   174\t    let result = env\n   175\t        .dispatch_command()\n   176\t        .args([\n   177\t            \"--json\",\n   178\t            \"--prompt\",\n   179\t            \"review\",\n   180\t            \"--cwd\",\n   181\t            env.home.to_str().expect(\"utf-8 home path\"),\n   182\t        ])\n   183\t        .env(\"CODEX_MOCK_MODE\", \"success\")\n   184\t        .output()?;\n   185\t\n   186\t    assert!(result.status.success(), \"stderr: {:?}\", result.stderr);\n   187\t    let parsed: Value = serde_json::from_slice(&result.stdout)?;\n   188\t    assert_eq!(parsed[\"status\"], \"completed\");\n   189\t    assert!(!tmp_store.exists());\n   190\t    assert!(!home_dispatch_root(&env.home).exists());\n   191\t\n   192\t    Ok(())\n   193\t}\n   194\t\n   195\t#[test]\n   196\tfn json_failed_dispatch_exits_1_and_reports_worker_exit_code(\n   197\t) -> Result<(), Box<dyn std::error::Error>> {\n   198\t    let env = MockEnv::new(\"json-failed-dispatch\")?;\n   199\t    let output = env.home.join(\"failed-result.md\");\n   200\t    let result = env\n   201\t        .dispatch_command()\n   202\t        .args([\n   203\t            \"--json\",\n   204\t            \"--prompt\",\n   205\t            \"review\",\n   206\t            \"--output\",\n   207\t            output.to_str().expect(\"utf-8 output path\"),\n   208\t            \"--cwd\",\n   209\t            env.home.to_str().expect(\"utf-8 home path\"),\n   210\t        ])\n   211\t        .env(\"CODEX_MOCK_MODE\", \"failed\")\n   212\t        .output()?;\n   213\t\n   214\t    assert_eq!(result.status.code(), Some(1));\n   215\t    let parsed: Value = serde_json::from_slice(&result.stdout)?;\n   216\t    assert_eq!(parsed[\"status\"], \"failed\");\n   217\t    assert_eq!(parsed[\"exit_code\"], 1);\n   218\t    assert_eq!(parsed[\"signal\"], Value::Null);\n   219\t    assert_eq!(parsed[\"error\"][\"code\"], \"process_failed\");\n   220\t\n   221\t    Ok(())\n   222\t}\n   223\t\n   224\t#[test]\n   225\tfn plain_dispatch_output_reports_status_duration_and_output(\n   226\t) -> Result<(), Box<dyn std::error::Error>> {\n   227\t    let env = MockEnv::new(\"plain-output\")?;\n   228\t    let output = env.home.join(\"plain-result.md\");\n   229\t    let result = env\n   230\t        .dispatch_command()\n   231\t        .args([\n   232\t            \"--prompt\",\n   233\t            \"review\",\n   234\t            \"--output\",\n   235\t            output.to_str().expect(\"utf-8 output path\"),\n   236\t            \"--cwd\",\n   237\t            env.home.to_str().expect(\"utf-8 home path\"),\n   238\t        ])\n   239\t        .env(\"CODEX_MOCK_MODE\", \"success\")\n   240\t        .output()?;\n   241\t\n   242\t    assert_eq!(result.status.code(), Some(0));\n   243\t    let stdout = String::from_utf8(result.stdout)?;\n   244\t    let lines = stdout.lines().collect::<Vec<_>>();\n   245\t    assert_eq!(lines.len(), 3, \"{stdout}\");\n   246\t    assert_eq!(lines[0], \"status: completed\");\n   247\t    let duration_ms = lines[1]\n   248\t        .strip_prefix(\"duration_ms: \")\n   249\t        .expect(\"duration_ms line\");\n   250\t    duration_ms.parse::<u64>().expect(\"duration is numeric\");\n   251\t    assert_eq!(lines[2], format!(\"output: {}\", output.display()));\n   252\t    assert_eq!(std::fs::read_to_string(&output)?, \"mock output\\n\");\n   253\t\n   254\t    Ok(())\n   255\t}\n   256\t\n   257\t#[test]\n   258\tfn existing_files_under_old_store_paths_are_unchanged() -> Result<(), Box<dyn std::error::Error>> {\n   259\t    let _guard = STORE_PATH_LOCK.lock().expect(\"store path mutex poisoned\");\n   260\t    let env = MockEnv::new(\"store-sentinels\")?;\ntools/darkfactory-dispatch/tests/engine.rs\n     1\t#[path = \"../src/engine.rs\"]\n     2\tmod engine;\n     3\t#[expect(\n     4\t    dead_code,\n     5\t    reason = \"integration tests exercise event emission through Emitter::with_writer\"\n     6\t)]\n     7\t#[path = \"../src/event.rs\"]\n     8\tmod event;\n     9\t#[path = \"../src/supervisor.rs\"]\n    10\tmod supervisor;\n    11\t#[path = \"../src/types.rs\"]\n    12\tmod types;\n    13\t\n    14\tuse std::io::{self, Write};\n    15\tuse std::path::{Path, PathBuf};\n    16\tuse std::sync::atomic::{AtomicU64, Ordering};\n    17\tuse std::sync::{Arc, LazyLock, Mutex};\n    18\tuse std::time::{Duration, Instant};\n    19\t\n    20\tuse event::Emitter;\n    21\tuse nix::libc;\n    22\tuse serde_json::Value;\n    23\tuse tokio::sync::Mutex as AsyncMutex;\n    24\tuse types::{DispatchError, DispatchSpec, DispatchStatus};\n    25\t\n    26\tstatic TEST_ID: AtomicU64 = AtomicU64::new(1);\n    27\tstatic PATH_LOCK: LazyLock<AsyncMutex<()>> = LazyLock::new(|| AsyncMutex::new(()));\n    28\t\n    29\t#[derive(Clone)]\n    30\tstruct SharedBuffer {\n    31\t    inner: Arc<Mutex<Vec<u8>>>,\n    32\t}\n    33\t\n    34\timpl Write for SharedBuffer {\n    35\t    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {\n    36\t        self.inner\n    37\t            .lock()\n    38\t            .expect(\"shared buffer mutex poisoned\")\n    39\t            .write(buf)\n    40\t    }\n    41\t\n    42\t    fn flush(&mut self) -> io::Result<()> {\n    43\t        Ok(())\n    44\t    }\n    45\t}\n    46\t\n    47\t#[tokio::test(flavor = \"multi_thread\")]\n    48\tasync fn successful_dispatch_tracks_tokens_and_activity() -> Result<(), Box<dyn std::error::Error>>\n    49\t{\n    50\t    let _path_guard = TestPath::install(\"success\").await?;\n    51\t    let tmp = temp_test_dir(\"success\")?;\n    52\t    let output = tmp.join(\"result.md\");\n    53\t    let log = tmp.join(\"codex.log\");\n    54\t    let result = engine::dispatch(\n    55\t        spec(&tmp, &output, Some(log.clone()), 10, 0),\n    56\t        \"dispatch-success\".to_string(),\n    57\t        emitter(\"dispatch-success\").0,\n    58\t    )\n    59\t    .await?;\n    60\t\n    61\t    assert_eq!(result.status, DispatchStatus::Completed);\n    62\t    assert_eq!(result.exit_code, Some(0));\n    63\t    assert!(result.output_exists);\n    64\t    assert_eq!(result.tokens.input, 100);\n    65\t    assert_eq!(result.tokens.output, 50);\n    66\t    assert_eq!(result.tokens.reasoning, 20);\n    67\t    assert_eq!(result.activity.tool_calls, 1);\n    68\t    assert_eq!(result.activity.commands_run, vec![\"cargo test\"]);\n    69\t    assert_eq!(result.activity.files_changed, vec![\"src/main.rs\"]);\n    70\t    assert_eq!(result.activity.files_read, vec![\"README.md\"]);\n    71\t\n    72\t    let log_text = std::fs::read_to_string(log)?;\n    73\t    assert!(log_text.contains(\"thread.started\"));\n    74\t    assert!(log_text.contains(\"mock stderr line\"));\n    75\t\n    76\t    Ok(())\n    77\t}\n    78\t\n    79\t#[tokio::test(flavor = \"multi_thread\")]\n    80\tasync fn timeout_dispatch_stops_child_process() -> Result<(), Box<dyn std::error::Error>> {\n    81\t    let _path_guard = TestPath::install(\"sleep\").await?;\n    82\t    let tmp = temp_test_dir(\"timeout\")?;\n    83\t    let output = tmp.join(\"result.md\");\n    84\t    let pid_file = tmp.join(\"pid\");\n    85\t    std::env::set_var(\"CODEX_MOCK_PID_FILE\", &pid_file);\n    86\t\n    87\t    let result = engine::dispatch(\n    88\t        spec(&tmp, &output, None, 1, 1),\n    89\t        \"dispatch-timeout\".to_string(),\n    90\t        emitter(\"dispatch-timeout\").0,\n    91\t    )\n    92\t    .await?;\n    93\t\n    94\t    std::env::remove_var(\"CODEX_MOCK_PID_FILE\");\n    95\t    assert_eq!(result.status, DispatchStatus::TimedOut);\n    96\t    assert!(result.error.as_ref().is_some_and(|error| error.retryable));\n    97\t\n    98\t    let pid = std::fs::read_to_string(pid_file)?.trim().parse::<i32>()?;\n    99\t    assert_process_exits(pid).await?;\n   100\t\n   101\t    Ok(())\n   102\t}\n   103\t\n   104\t#[tokio::test(flavor = \"multi_thread\")]\n   105\tasync fn hard_timeout_kills_child_that_ignores_sigterm() -> Result<(), Box<dyn std::error::Error>> {\n   106\t    let _path_guard = TestPath::install_script(\"test_codex_sigkill.sh\", None).await?;\n   107\t    let tmp = temp_test_dir(\"sigkill-timeout\")?;\n   108\t    let output = tmp.join(\"result.md\");\n   109\t    let pid_file = tmp.join(\"pid\");\n   110\t    std::env::set_var(\"CODEX_MOCK_PID_FILE\", &pid_file);\n   111\t\n   112\t    let started = Instant::now();\n   113\t    let result = engine::dispatch(\n   114\t        spec(&tmp, &output, None, 1, 2),\n   115\t        \"dispatch-sigkill-timeout\".to_string(),\n   116\t        emitter(\"dispatch-sigkill-timeout\").0,\n   117\t    )\n   118\t    .await?;\n   119\t    let elapsed = started.elapsed();\n   120\t\n   121\t    std::env::remove_var(\"CODEX_MOCK_PID_FILE\");\n   122\t    assert_eq!(result.status, DispatchStatus::TimedOut);\n   123\t\n   124\t    let pid = std::fs::read_to_string(pid_file)?.trim().parse::<i32>()?;\n   125\t    assert_process_exits(pid).await?;\n   126\t    assert!(\n   127\t        elapsed >= Duration::from_secs(3),\n   128\t        \"elapsed {elapsed:?} should include timeout plus grace\"\n   129\t    );\n   130\t    assert!(\n   131\t        elapsed < Duration::from_secs(8),\n   132\t        \"elapsed {elapsed:?} should not wait far beyond timeout plus grace\"\n   133\t    );\n   134\t\n   135\t    Ok(())\n   136\t}\n   137\t\n   138\t#[tokio::test(flavor = \"multi_thread\")]\n   139\tasync fn heartbeat_events_are_emitted_during_running_dispatch(\n   140\t) -> Result<(), Box<dyn std::error::Error>> {\n   141\t    let _path_guard = TestPath::install(\"delayed_success\").await?;\n   142\t    let tmp = temp_test_dir(\"heartbeat\")?;\n   143\t    let output = tmp.join(\"result.md\");\n   144\t    let (emitter, buffer) = emitter(\"dispatch-heartbeat\");\n   145\t\n   146\t    let result = engine::dispatch(\n   147\t        spec(&tmp, &output, None, 10, 0),\n   148\t        \"dispatch-heartbeat\".to_string(),\n   149\t        emitter,\n   150\t    )\n   151\t    .await?;\n   152\t\n   153\t    assert_eq!(result.status, DispatchStatus::Completed);\n   154\t    let events = buffer_events(&buffer)?;\n   155\t    let heartbeats = events\n   156\t        .iter()\n   157\t        .filter(|event| event[\"type\"] == \"heartbeat\")\n   158\t        .collect::<Vec<_>>();\n   159\t    assert!(heartbeats.len() >= 2, \"events: {events:?}\");\n   160\t    assert!(heartbeats\n   161\t        .iter()\n   162\t        .all(|event| event[\"interval_s\"].as_u64() == Some(1)));\n   163\t\n   164\t    Ok(())\n   165\t}\n   166\t\n   167\t#[tokio::test(flavor = \"multi_thread\")]\n   168\tasync fn malformed_ndjson_is_counted_and_logged() -> Result<(), Box<dyn std::error::Error>> {\n   169\t    let _path_guard = TestPath::install(\"malformed\").await?;\n   170\t    let tmp = temp_test_dir(\"malformed\")?;\n   171\t    let output = tmp.join(\"result.md\");\n   172\t    let log = tmp.join(\"codex.log\");\n   173\t    let result = engine::dispatch(\n   174\t        spec(&tmp, &output, Some(log.clone()), 10, 0),\n   175\t        \"dispatch-malformed\".to_string(),\n   176\t        emitter(\"dispatch-malformed\").0,\n   177\t    )\n   178\t    .await?;\n   179\t\n   180\t    assert_eq!(result.status, DispatchStatus::Completed);\n   181\t    assert_eq!(result.activity.parse_errors, 2);\n   182\t    let log_text = std::fs::read_to_string(log)?;\n   183\t    assert!(log_text.contains(\"not json\"));\n   184\t    assert!(log_text.contains(\"{still not json\"));\n   185\t\n   186\t    Ok(())\n   187\t}\n   188\t\n   189\t#[tokio::test(flavor = \"multi_thread\")]\n   190\tasync fn parse_errors_without_response_fail_dispatch() -> Result<(), Box<dyn std::error::Error>> {\n   191\t    let _path_guard = TestPath::install(\"malformed_only\").await?;\n   192\t    let tmp = temp_test_dir(\"malformed-only\")?;\n   193\t    let output = tmp.join(\"result.md\");\n   194\t    let result = engine::dispatch(\n   195\t        spec(&tmp, &output, None, 10, 0),\n   196\t        \"dispatch-malformed-only\".to_string(),\n   197\t        emitter(\"dispatch-malformed-only\").0,\n   198\t    )\n   199\t    .await?;\n   200\t\n   201\t    assert_eq!(result.status, DispatchStatus::Failed);\n   202\t    assert_eq!(result.exit_code, Some(0));\n   203\t    assert!(result.output_exists);\n   204\t    assert_eq!(result.activity.parse_errors, 2);\n   205\t    let error = result.error.as_ref().expect(\"failed result has error\");\n   206\t    assert_eq!(error.code, \"output_parse_error\");\n   207\t    assert_eq!(\n   208\t        error.message,\n   209\t        \"Harness output contained 2 parse error(s) and no final response could be trusted.\"\n   210\t    );\n   211\t\n   212\t    Ok(())\n   213\t}\n   214\t\n   215\t#[tokio::test(flavor = \"multi_thread\")]\n   216\tasync fn missing_codex_binary_returns_binary_not_found() -> Result<(), Box<dyn std::error::Error>> {\n   217\t    let _path_guard = TestPath::missing_binary().await?;\n   218\t    let tmp = temp_test_dir(\"missing-binary\")?;\n   219\t    let output = tmp.join(\"result.md\");\n   220\t\n   221\t    let result = engine::dispatch(\n   222\t        spec(&tmp, &output, None, 10, 0),\n   223\t        \"dispatch-missing-binary\".to_string(),\n   224\t        emitter(\"dispatch-missing-binary\").0,\n   225\t    )\n   226\t    .await;\n   227\t\n   228\t    assert!(matches!(result, Err(DispatchError::BinaryNotFound)));\n   229\t\n   230\t    Ok(())\n   231\t}\n   232\t\n   233\t#[tokio::test(flavor = \"multi_thread\")]\n   234\tasync fn failed_child_reports_failed_status_and_exit_code() -> Result<(), Box<dyn std::error::Error>>\n   235\t{\n   236\t    let _path_guard = TestPath::install(\"failed\").await?;\n   237\t    let tmp = temp_test_dir(\"failed-child\")?;\n   238\t    let output = tmp.join(\"result.md\");\n   239\t\n   240\t    let result = engine::dispatch(\n   241\t        spec(&tmp, &output, None, 10, 0),\n   242\t        \"dispatch-failed-child\".to_string(),\n   243\t        emitter(\"dispatch-failed-child\").0,\n   244\t    )\n   245\t    .await?;\n   246\t\n   247\t    assert_eq!(result.status, DispatchStatus::Failed);\n   248\t    assert_eq!(result.exit_code, Some(1));\n   249\t    assert_eq!(result.signal, None);\n   250\t    assert!(result.output_exists);\n   251\t    assert_eq!(\n   252\t        result.error.as_ref().map(|error| error.code.as_str()),\n   253\t        Some(\"process_failed\")\n   254\t    );\n   255\t\n   256\t    Ok(())\n   257\t}\n   258\t\n   259\t#[tokio::test(flavor = \"multi_thread\")]\n   260\tasync fn missing_output_file_reports_failed_result() -> Result<(), Box<dyn std::error::Error>> {\ntools/darkfactory-dispatch/tests/smoketest.sh\n     1\t#!/bin/sh\n     2\t# smoketest.sh -- live-codex end-to-end tests for darkfactory-dispatch\n     3\t# Requires: darkfactory-dispatch on PATH, codex CLI authenticated\n     4\t# Run: ./tests/smoketest.sh (or: make smoke)\n     5\tset -e\n     6\t\n     7\tDISPATCH=\"darkfactory-dispatch\"\n     8\tTMPDIR=$(mktemp -d /tmp/dispatch-smoke.XXXXXX)\n     9\tPASS=0\n    10\tFAIL=0\n    11\t\n    12\tcleanup() {\n    13\t    rm -rf \"$TMPDIR\"\n    14\t}\n    15\ttrap cleanup EXIT\n    16\t\n    17\t# Extract a JSON field from a file using grep (avoids jq control-char issues)\n    18\tjson_field() {\n    19\t    grep -o \"\\\"$1\\\":\\\"[^\\\"]*\\\"\" \"$2\" 2>/dev/null | head -1 | cut -d'\"' -f4\n    20\t}\n    21\tjson_bool() {\n    22\t    grep -o \"\\\"$1\\\":[a-z]*\" \"$2\" 2>/dev/null | head -1 | cut -d: -f2\n    23\t}\n    24\t\n    25\tcheck() {\n    26\t    TEST_NAME=\"$1\"\n    27\t    shift\n    28\t    if \"$@\"; then\n    29\t        PASS=$((PASS + 1))\n    30\t        printf \"  PASS  %s\\n\" \"$TEST_NAME\"\n    31\t    else\n    32\t        FAIL=$((FAIL + 1))\n    33\t        printf \"  FAIL  %s\\n\" \"$TEST_NAME\"\n    34\t    fi\n    35\t}\n    36\t\n    37\techo \"=== darkfactory-dispatch smoke tests ===\"\n    38\techo \"\"\n    39\t\n    40\t# Verify binary exists\n    41\tcommand -v \"$DISPATCH\" >/dev/null 2>&1 || {\n    42\t    echo \"ERROR: $DISPATCH not found on PATH. Run: make install\"\n    43\t    exit 2\n    44\t}\n    45\t\n    46\t# Verify codex is available\n    47\tcommand -v codex >/dev/null 2>&1 || {\n    48\t    echo \"ERROR: codex not found on PATH. Install: npm install -g @openai/codex\"\n    49\t    exit 2\n    50\t}\n    51\t\n    52\techo \"Binary: $(command -v \"$DISPATCH\")\"\n    53\techo \"Version: $(\"$DISPATCH\" --version)\"\n    54\techo \"\"\n    55\t\n    56\t# --- Test 1: Simple task (write a file) ---\n    57\techo \"Test 1: Simple task\"\n    58\t\"$DISPATCH\" \\\n    59\t    --model gpt-5.5 \\\n    60\t    --effort low \\\n    61\t    --timeout 60 \\\n    62\t    --sandbox workspace-write \\\n    63\t    --prompt \"Create a file called $TMPDIR/smoke-output.txt containing the text 'smoke test passed'. Use echo or printf.\" \\\n    64\t    --output \"$TMPDIR/smoke-output.txt\" \\\n    65\t    --json > \"$TMPDIR/result1.json\" 2>/dev/null || true\n    66\t\n    67\tcheck \"dispatch completes\" [ \"$(json_field status \"$TMPDIR/result1.json\")\" = \"completed\" ]\n    68\tcheck \"output file exists\" [ \"$(json_bool output_exists \"$TMPDIR/result1.json\")\" = \"true\" ]\n    69\tcheck \"output file has content\" [ -s \"$TMPDIR/smoke-output.txt\" ]\n    70\t\n    71\techo \"\"\n    72\t\n    73\t# --- Test 2: Timeout (child killed) ---\n    74\techo \"Test 2: Timeout handling\"\n    75\t\"$DISPATCH\" \\\n    76\t    --model gpt-5.5 \\\n    77\t    --effort high \\\n    78\t    --timeout 10 \\\n    79\t    --grace 5 \\\n    80\t    --sandbox workspace-write \\\n    81\t    --prompt \"Run the command: sleep 300. Wait for it to complete. Do not skip or cancel.\" \\\n    82\t    --json > \"$TMPDIR/result2.json\" 2>/dev/null || true\n    83\t\n    84\tcheck \"dispatch times out\" [ \"$(json_field status \"$TMPDIR/result2.json\")\" = \"timed_out\" ]\n    85\tcheck \"error is retryable\" [ \"$(json_bool retryable \"$TMPDIR/result2.json\")\" = \"true\" ]\n    86\t\n    87\techo \"\"\n    88\t\n    89\t# --- Test 3: Prompt file ---\n    90\techo \"Test 3: Prompt file\"\n    91\tprintf 'Create a file called %s/prompt-test.txt containing \"prompt file works\".\\n' \"$TMPDIR\" > \"$TMPDIR/prompt.txt\"\n    92\t\n    93\t\"$DISPATCH\" \\\n    94\t    --model gpt-5.5 \\\n    95\t    --effort low \\\n    96\t    --timeout 60 \\\n    97\t    --sandbox workspace-write \\\n    98\t    --prompt-file \"$TMPDIR/prompt.txt\" \\\n    99\t    --output \"$TMPDIR/prompt-test.txt\" \\\n   100\t    --json > \"$TMPDIR/result3.json\" 2>/dev/null || true\n   101\t\n   102\tcheck \"prompt-file dispatch completes\" [ \"$(json_field status \"$TMPDIR/result3.json\")\" = \"completed\" ]\n   103\t\n   104\techo \"\"\n   105\t\n   106\t# --- Summary ---\n   107\tTOTAL=$((PASS + FAIL))\n   108\techo \"=== Results: $PASS/$TOTAL passed ===\"\n   109\t\n   110\tif [ \"$FAIL\" -gt 0 ]; then\n   111\t    echo \"FAILED\"\n   112\t    exit 1\n   113\telse\n   114\t    echo \"ALL PASSED\"\n   115\t    exit 0\n   116\tfi\ntools/darkfactory-dispatch/tests/supervisor.rs\n     1\t#[expect(\n     2\t    dead_code,\n     3\t    reason = \"integration tests exercise this module boundary directly\"\n     4\t)]\n     5\t#[path = \"../src/supervisor.rs\"]\n     6\tmod supervisor;\n     7\t\n     8\tuse std::io;\n     9\tuse std::path::{Path, PathBuf};\n    10\tuse std::process::{Command, Stdio};\n    11\tuse std::time::{Duration, Instant};\n    12\tuse std::time::{SystemTime, UNIX_EPOCH};\n    13\t\n    14\tuse nix::libc;\n    15\tuse supervisor::SupervisorBuilder;\n    16\tuse tokio::io::{AsyncBufReadExt, BufReader};\n    17\t\n    18\t#[tokio::test(flavor = \"multi_thread\")]\n    19\tasync fn spawn_nonexistent_binary_returns_error() -> Result<(), Box<dyn std::error::Error>> {\n    20\t    let result = SupervisorBuilder::new(\"nonexistent-binary-xyz\").spawn();\n    21\t\n    22\t    assert!(result.is_err());\n    23\t\n    24\t    Ok(())\n    25\t}\n    26\t\n    27\t#[tokio::test(flavor = \"multi_thread\")]\n    28\tasync fn kill_terminates_the_whole_process_group() -> Result<(), Box<dyn std::error::Error>> {\n    29\t    let script = \"sleep 300 & bg=$!; sleep 300 & fg=$!; echo $$ $bg $fg; wait\";\n    30\t    let handle = SupervisorBuilder::new(\"sh\").args([\"-c\", script]).spawn()?;\n    31\t\n    32\t    let mut lines = BufReader::new(handle.stdout()?).lines();\n    33\t    let line = tokio::time::timeout(Duration::from_secs(2), lines.next_line())\n    34\t        .await??\n    35\t        .ok_or(\"child did not print process ids\")?;\n    36\t    let pids = parse_pids(&line)?;\n    37\t    assert_eq!(pids.len(), 3);\n    38\t\n    39\t    handle.kill()?;\n    40\t    let result = handle.wait().await?;\n    41\t\n    42\t    assert_eq!(result.signal, Some(libc::SIGKILL));\n    43\t    for pid in pids {\n    44\t        assert_process_exits(pid).await?;\n    45\t    }\n    46\t\n    47\t    Ok(())\n    48\t}\n    49\t\n    50\t#[tokio::test(flavor = \"multi_thread\")]\n    51\tasync fn kill_soft_sends_sigterm() -> Result<(), Box<dyn std::error::Error>> {\n    52\t    let handle = SupervisorBuilder::new(\"sleep\").args([\"300\"]).spawn()?;\n    53\t\n    54\t    handle.kill_soft()?;\n    55\t    let result = handle.wait().await?;\n    56\t\n    57\t    assert_eq!(result.signal, Some(libc::SIGTERM));\n    58\t\n    59\t    Ok(())\n    60\t}\n    61\t\n    62\t#[tokio::test(flavor = \"multi_thread\")]\n    63\tasync fn normal_exit_reports_code_without_signal() -> Result<(), Box<dyn std::error::Error>> {\n    64\t    let handle = SupervisorBuilder::new(\"true\").spawn()?;\n    65\t    let result = handle.wait().await?;\n    66\t\n    67\t    assert_eq!(result.code, Some(0));\n    68\t    assert_eq!(result.signal, None);\n    69\t\n    70\t    Ok(())\n    71\t}\n    72\t\n    73\t#[tokio::test(flavor = \"multi_thread\")]\n    74\tasync fn wait_reports_sigterm_and_sigkill() -> Result<(), Box<dyn std::error::Error>> {\n    75\t    let term_handle = SupervisorBuilder::new(\"sleep\").args([\"300\"]).spawn()?;\n    76\t    term_handle.kill_soft()?;\n    77\t    let term_result = term_handle.wait().await?;\n    78\t    assert_eq!(term_result.signal, Some(libc::SIGTERM));\n    79\t    assert_eq!(term_handle.wait().await?, term_result);\n    80\t\n    81\t    let kill_handle = SupervisorBuilder::new(\"sleep\").args([\"300\"]).spawn()?;\n    82\t    kill_handle.kill()?;\n    83\t    let kill_result = kill_handle.wait().await?;\n    84\t    assert_eq!(kill_result.signal, Some(libc::SIGKILL));\n    85\t\n    86\t    Ok(())\n    87\t}\n    88\t\n    89\t#[tokio::test(flavor = \"multi_thread\")]\n    90\tasync fn two_phase_timeout_escalates_from_sigterm_to_sigkill(\n    91\t) -> Result<(), Box<dyn std::error::Error>> {\n    92\t    let script = \"trap '' TERM; echo $$; sleep 300\";\n    93\t    let handle = SupervisorBuilder::new(\"sh\").args([\"-c\", script]).spawn()?;\n    94\t\n    95\t    let mut lines = BufReader::new(handle.stdout()?).lines();\n    96\t    let pid = tokio::time::timeout(Duration::from_secs(2), lines.next_line())\n    97\t        .await??\n    98\t        .ok_or(\"child did not print pid\")?\n    99\t        .parse::<i32>()?;\n   100\t\n   101\t    handle.kill_soft()?;\n   102\t    tokio::time::sleep(Duration::from_millis(200)).await;\n   103\t    assert!(process_exists(pid));\n   104\t\n   105\t    handle.kill()?;\n   106\t    let result = handle.wait().await?;\n   107\t\n   108\t    assert_eq!(result.signal, Some(libc::SIGKILL));\n   109\t    assert_process_exits(pid).await?;\n   110\t\n   111\t    Ok(())\n   112\t}\n   113\t\n   114\t#[cfg(target_os = \"linux\")]\n   115\t#[tokio::test(flavor = \"multi_thread\")]\n   116\tasync fn parent_death_terminates_supervised_child() -> Result<(), Box<dyn std::error::Error>> {\n   117\t    let tmp = temp_test_dir(\"parent-death\")?;\n   118\t    let pid_file = tmp.join(\"pid\");\n   119\t    let status = Command::new(std::env::current_exe()?)\n   120\t        .args([\n   121\t            \"--exact\",\n   122\t            \"parent_death_helper_spawns_supervised_child\",\n   123\t            \"--ignored\",\n   124\t            \"--nocapture\",\n   125\t        ])\n   126\t        .env(\"DARKFACTORY_PARENT_DEATH_PID_FILE\", &pid_file)\n   127\t        .stdout(Stdio::null())\n   128\t        .stderr(Stdio::null())\n   129\t        .status()?;\n   130\t\n   131\t    assert!(status.success());\n   132\t    let pid = wait_for_pid_file(&pid_file).await?;\n   133\t    assert_process_stops(pid).await?;\n   134\t\n   135\t    Ok(())\n   136\t}\n   137\t\n   138\t#[cfg(target_os = \"linux\")]\n   139\t#[ignore]\n   140\t#[tokio::test(flavor = \"multi_thread\")]\n   141\tasync fn parent_death_helper_spawns_supervised_child() -> Result<(), Box<dyn std::error::Error>> {\n   142\t    let Some(pid_file) = std::env::var_os(\"DARKFACTORY_PARENT_DEATH_PID_FILE\") else {\n   143\t        return Ok(());\n   144\t    };\n   145\t    let pid_file = PathBuf::from(pid_file);\n   146\t    let pid_path = pid_file.to_str().ok_or(\"pid file path is not utf-8\")?;\n   147\t    let _handle = SupervisorBuilder::new(\"sh\")\n   148\t        .args([\"-c\", \"echo $$ > \\\"$1\\\"; exec sleep 300\", \"sh\", pid_path])\n   149\t        .spawn()?;\n   150\t\n   151\t    let _pid = wait_for_pid_file(&pid_file).await?;\n   152\t    std::process::exit(0);\n   153\t}\n   154\t\n   155\tfn parse_pids(line: &str) -> Result<Vec<i32>, Box<dyn std::error::Error>> {\n   156\t    line.split_whitespace()\n   157\t        .map(str::parse::<i32>)\n   158\t        .collect::<Result<Vec<_>, _>>()\n   159\t        .map_err(Into::into)\n   160\t}\n   161\t\n   162\tfn temp_test_dir(name: &str) -> io::Result<PathBuf> {\n   163\t    let nanos = SystemTime::now()\n   164\t        .duration_since(UNIX_EPOCH)\n   165\t        .unwrap_or_default()\n   166\t        .as_nanos();\n   167\t    let path = std::env::temp_dir().join(format!(\n   168\t        \"darkfactory-supervisor-{}-{name}-{nanos}\",\n   169\t        std::process::id()\n   170\t    ));\n   171\t    std::fs::create_dir_all(&path)?;\n   172\t    Ok(path)\n   173\t}\n   174\t\n   175\tasync fn wait_for_pid_file(path: &Path) -> Result<i32, Box<dyn std::error::Error>> {\n   176\t    let deadline = Instant::now() + Duration::from_secs(3);\n   177\t    loop {\n   178\t        match std::fs::read_to_string(path) {\n   179\t            Ok(text) => return text.trim().parse::<i32>().map_err(Into::into),\n   180\t            Err(error) if error.kind() == io::ErrorKind::NotFound => {}\n   181\t            Err(error) => return Err(error.into()),\n   182\t        }\n   183\t        if Instant::now() >= deadline {\n   184\t            return Err(format!(\"pid file was not written: {}\", path.display()).into());\n   185\t        }\n   186\t        tokio::time::sleep(Duration::from_millis(50)).await;\n   187\t    }\n   188\t}\n   189\t\n   190\tasync fn assert_process_exits(pid: i32) -> Result<(), Box<dyn std::error::Error>> {\n   191\t    let deadline = Instant::now() + Duration::from_secs(3);\n   192\t    loop {\n   193\t        if !process_exists(pid) {\n   194\t            return Ok(());\n   195\t        }\n   196\t        if Instant::now() >= deadline {\n   197\t            return Err(format!(\"process {pid} still exists\").into());\n   198\t        }\n   199\t        tokio::time::sleep(Duration::from_millis(50)).await;\n   200\t    }\n   201\t}\n   202\t\n   203\t#[cfg(target_os = \"linux\")]\n   204\tasync fn assert_process_stops(pid: i32) -> Result<(), Box<dyn std::error::Error>> {\n   205\t    let deadline = Instant::now() + Duration::from_secs(3);\n   206\t    loop {\n   207\t        if !process_is_running(pid) {\n   208\t            return Ok(());\n   209\t        }\n   210\t        if Instant::now() >= deadline {\n   211\t            return Err(format!(\"process {pid} is still running\").into());\n   212\t        }\n   213\t        tokio::time::sleep(Duration::from_millis(50)).await;\n   214\t    }\n   215\t}\n   216\t\n   217\tfn process_exists(pid: i32) -> bool {\n   218\t    // SAFETY: kill(pid, 0) does not send a signal. It only checks whether the\n   219\t    // process exists and whether this process can signal it.\n   220\t    let rc = unsafe { libc::kill(pid, 0) };\n   221\t    if rc == 0 {\n   222\t        return true;\n   223\t    }\n   224\t\n   225\t    io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)\n   226\t}\n   227\t\n   228\t#[cfg(target_os = \"linux\")]\n   229\tfn process_is_running(pid: i32) -> bool {\n   230\t    if !process_exists(pid) {\n   231\t        return false;\n   232\t    }\n   233\t\n   234\t    let Ok(stat) = std::fs::read_to_string(format!(\"/proc/{pid}/stat\")) else {\n   235\t        return true;\n   236\t    };\n   237\t    let Some((_, after_name)) = stat.rsplit_once(\") \") else {\n   238\t        return true;\n   239\t    };\n   240\t    !after_name.starts_with('Z')\n   241\t}\ntools/darkfactory-dispatch/tests/test_codex_mock.sh\n     1\t#!/usr/bin/env bash\n     2\tset -euo pipefail\n     3\t\n     4\toutput=\"\"\n     5\twhile (($#)); do\n     6\t  if [[ \"$1\" == \"-o\" && $# -ge 2 ]]; then\n     7\t    output=\"$2\"\n     8\t    shift 2\n     9\t    continue\n    10\t  fi\n    11\t  shift\n    12\tdone\n    13\t\n    14\tmode=\"${CODEX_MOCK_MODE:-success}\"\n    15\tif [[ -n \"${CODEX_MOCK_PID_FILE:-}\" ]]; then\n    16\t  echo \"$$\" > \"${CODEX_MOCK_PID_FILE}\"\n    17\tfi\n    18\t\n    19\twrite_output() {\n    20\t  if [[ -n \"$output\" ]]; then\n    21\t    mkdir -p \"$(dirname \"$output\")\"\n    22\t    echo \"mock output\" > \"$output\"\n    23\t  fi\n    24\t}\n    25\t\n    26\tcase \"$mode\" in\n    27\t  success)\n    28\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"test-123\"}'\n    29\t    echo '{\"type\":\"item.started\",\"item\":{\"type\":\"tool_use\",\"name\":\"shell\"}}'\n    30\t    echo '{\"type\":\"item.started\",\"item\":{\"type\":\"function_call\",\"command\":\"cargo test\"}}'\n    31\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"function_call\",\"command\":\"cargo test\"}}'\n    32\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"file_change\",\"file_path\":\"src/main.rs\"}}'\n    33\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"file_read\",\"file_path\":\"README.md\"}}'\n    34\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"tool_use\",\"name\":\"shell\"}}'\n    35\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":100,\"output_tokens\":50,\"reasoning_tokens\":20}}'\n    36\t    echo \"mock stderr line\" >&2\n    37\t    write_output\n    38\t    ;;\n    39\t  malformed)\n    40\t    echo 'not json'\n    41\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"mock response\"}}'\n    42\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":1,\"output_tokens\":2,\"reasoning_tokens\":3}}'\n    43\t    echo '{still not json'\n    44\t    write_output\n    45\t    ;;\n    46\t  malformed_only)\n    47\t    echo 'not json'\n    48\t    echo '{still not json'\n    49\t    write_output\n    50\t    ;;\n    51\t  failed)\n    52\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"fail-test\"}'\n    53\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":10,\"output_tokens\":5,\"reasoning_tokens\":0}}'\n    54\t    write_output\n    55\t    exit 1\n    56\t    ;;\n    57\t  no_output)\n    58\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"no-output\"}'\n    59\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":10,\"output_tokens\":5,\"reasoning_tokens\":0}}'\n    60\t    ;;\n    61\t  response_no_output)\n    62\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"resp-no-output\"}'\n    63\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"recovered analysis content\"}}'\n    64\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":1,\"output_tokens\":2,\"reasoning_tokens\":3}}'\n    65\t    ;;\n    66\t  response_with_output)\n    67\t    # Worker writes its own output file AND emits a different final message. The\n    68\t    # supervisor must keep the worker's file, not overwrite it with the message.\n    69\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"resp-with-output\"}'\n    70\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"fallback response text\"}}'\n    71\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":1,\"output_tokens\":2,\"reasoning_tokens\":3}}'\n    72\t    write_output\n    73\t    ;;\n    74\t  empty_response_no_output)\n    75\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"empty-resp\"}'\n    76\t    echo '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"\"}}'\n    77\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":1,\"output_tokens\":2,\"reasoning_tokens\":3}}'\n    78\t    ;;\n    79\t  special_chars)\n    80\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"special-chars\"}'\n    81\t    echo '{\"type\":\"item.started\",\"item\":{\"type\":\"function_call\",\"command\":\"grep -n \\\"foo\\\\bar\\\" baz | jq .x\"}}'\n    82\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":1,\"output_tokens\":2,\"reasoning_tokens\":3}}'\n    83\t    write_output\n    84\t    ;;\n    85\t  term_clean)\n    86\t    trap 'exit 0' TERM\n    87\t    sleep 300\n    88\t    ;;\n    89\t  sleep)\n    90\t    sleep 300\n    91\t    ;;\n    92\t  delayed_success)\n    93\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"slow-123\"}'\n    94\t    sleep 3\n    95\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":4,\"output_tokens\":5,\"reasoning_tokens\":6}}'\n    96\t    write_output\n    97\t    ;;\n    98\t  delayed_success_5)\n    99\t    echo '{\"type\":\"thread.started\",\"thread_id\":\"slow-456\"}'\n   100\t    sleep 5\n   101\t    echo '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":4,\"output_tokens\":5,\"reasoning_tokens\":6}}'\n   102\t    write_output\n   103\t    ;;\n   104\t  *)\n   105\t    echo \"unknown CODEX_MOCK_MODE: $mode\" >&2\n   106\t    exit 64\n   107\t    ;;\n   108\tesac\ntools/darkfactory-dispatch/tests/test_codex_sigkill.sh\n     1\t#!/bin/bash\n     2\tset -euo pipefail\n     3\t\n     4\tif [[ -n \"${CODEX_MOCK_PID_FILE:-}\" ]]; then\n     5\t  echo \"$$\" > \"${CODEX_MOCK_PID_FILE}\"\n     6\tfi\n     7\t\n     8\ttrap '' TERM\n     9\techo '{\"type\":\"thread.started\",\"thread_id\":\"sigkill-test\"}'\n    10\tsleep 300\n","exit_code":0,"status":"completed"}}
