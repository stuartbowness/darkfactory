 .into_iter()\n   903\t            .map(|arg| arg.to_string_lossy().to_string())\n   904\t            .collect::<Vec<_>>();\n   905\t\n   906\t        let prompt = args.last().expect(\"args should have a prompt\");\n   907\t        assert_eq!(prompt, \"do work\");\n   908\t    }\n   909\t\n   910\t    #[test]\n   911\t    fn effective_grace_defaults_to_half_timeout() {\n   912\t        assert_eq!(effective_grace_sec(900, 0), 450);\n   913\t    }\n   914\t\n   915\t    #[test]\n   916\t    fn effective_grace_has_one_second_minimum() {\n   917\t        assert_eq!(effective_grace_sec(1, 0), 1);\n   918\t        assert_eq!(effective_grace_sec(0, 0), 1);\n   919\t    }\n   920\t\n   921\t    #[test]\n   922\t    fn effective_grace_uses_explicit_value() {\n   923\t        assert_eq!(effective_grace_sec(900, 30), 30);\n   924\t    }\n   925\t\n   926\t    #[test]\n   927\t    fn malformed_json_is_raw_passthrough() {\n   928\t        let event = parse_codex_event(\"not json\").expect(\"event\");\n   929\t        assert_eq!(event.kind, EventKind::RawPassthrough);\n   930\t        assert_eq!(event.text.as_deref(), Some(\"not json\"));\n   931\t    }\n   932\t\n   933\t    #[test]\n   934\t    fn parse_codex_event_table() {\n   935\t        let cases = vec![\n   936\t            (\n   937\t                \"thread.started\",\n   938\t                r#\"{\"type\":\"thread.started\",\"thread_id\":\"test-abc-123\"}\"#,\n   939\t                Some(EventKind::SessionStart),\n   940\t            ),\n   941\t            (\n   942\t                \"item.started tool_use\",\n   943\t                r#\"{\"type\":\"item.started\",\"item\":{\"type\":\"tool_use\",\"name\":\"shell\"}}\"#,\n   944\t                Some(EventKind::ToolStart),\n   945\t            ),\n   946\t            (\n   947\t                \"item.started agent_message\",\n   948\t                r#\"{\"type\":\"item.started\",\"item\":{\"type\":\"agent_message\"}}\"#,\n   949\t                None,\n   950\t            ),\n   951\t            (\n   952\t                \"item.started command_execution\",\n   953\t                r#\"{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\",\"command\":\"cargo test\"}}\"#,\n   954\t                Some(EventKind::CommandRun),\n   955\t            ),\n   956\t            (\n   957\t                \"item.completed agent_message\",\n   958\t                r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"I created the file.\"}}\"#,\n   959\t                Some(EventKind::Response),\n   960\t            ),\n   961\t            (\n   962\t                \"item.completed tool_use\",\n   963\t                r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"tool_use\",\"name\":\"shell\"}}\"#,\n   964\t                Some(EventKind::ToolEnd),\n   965\t            ),\n   966\t            (\n   967\t                \"item.completed command_execution\",\n   968\t                r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\",\"command\":\"cargo test\"}}\"#,\n   969\t                Some(EventKind::ToolEnd),\n   970\t            ),\n   971\t            (\n   972\t                \"item.completed file write\",\n   973\t                r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"tool_use\",\"name\":\"write\",\"file_path\":\"src/main.rs\"}}\"#,\n   974\t                Some(EventKind::FileWrite),\n   975\t            ),\n   976\t            (\n   977\t                \"item.completed file read\",\n   978\t                r#\"{\"type\":\"item.completed\",\"item\":{\"type\":\"tool_use\",\"name\":\"read\",\"file_path\":\"Cargo.toml\"}}\"#,\n   979\t                Some(EventKind::FileRead),\n   980\t            ),\n   981\t            (\n   982\t                \"turn.completed\",\n   983\t                r#\"{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":100,\"output_tokens\":50,\"reasoning_tokens\":20}}\"#,\n   984\t                Some(EventKind: