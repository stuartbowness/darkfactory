 488\t\n   489\timpl EventBuilder for HarnessEvent {\n   490\t    fn tool(mut self, tool: Option<String>) -> Self {\n   491\t        self.tool = tool;\n   492\t        self\n   493\t    }\n   494\t\n   495\t    fn file(mut self, file: Option<String>) -> Self {\n   496\t        self.file = file;\n   497\t        self\n   498\t    }\n   499\t\n   500\t    fn command(mut self, command: Option<String>) -> Self {\n   501\t        self.command = command;\n   502\t        self\n   503\t    }\n   504\t\n   505\t    fn text(mut self, text: impl Into<String>) -> Self {\n   506\t        self.text = Some(text.into());\n   507\t        self\n   508\t    }\n   509\t\n   510\t    fn tokens(mut self, tokens: TokenUsage) -> Self {\n   511\t        self.tokens = Some(tokens);\n   512\t        self\n   513\t    }\n   514\t\n   515\t    fn session_id(mut self, session_id: Option<String>) -> Self {\n   516\t        self.session_id = session_id;\n   517\t        self\n   518\t    }\n   519\t}\n   520\t\n   521\tstruct ActivityTracker {\n   522\t    activity: Activity,\n   523\t    tokens: TokenUsage,\n   524\t    last_activity: String,\n   525\t    response_seen: bool,\n   526\t    final_response: Option<String>,\n   527\t}\n   528\t\n   529\timpl ActivityTracker {\n   530\t    fn new() -> Self {\n   531\t        Self {\n   532\t            activity: Activity::default(),\n   533\t            tokens: TokenUsage::default(),\n   534\t            last_activity: \"dispatch started\".to_string(),\n   535\t            response_seen: false,\n   536\t            final_response: None,\n   537\t        }\n   538\t    }\n   539\t\n   540\t    fn apply(&mut self, event: HarnessEvent, emitter: &Emitter) -> Result<(), DispatchError> {\n   541\t        match event.kind {\n   542\t            EventKind::SessionStart => {\n   543\t                self.last_activity = format!(\n   544\t                    \"session started: {}\",\n   545\t                    event.session_id.unwrap_or_else(|| \"unknown\".to_string())\n   546\t                );\n   547\t            }\n   548\t            EventKind::ToolStart => {\n   549\t                let tool = event.tool.unwrap_or_else(|| \"tool\".to_string());\n   550\t                self.activity.tool_calls += 1;\n   551\t                self.last_activity = format!(\"tool started: {tool}\");\n   552\t                emitter\n   553\t                    .emit_tool_start(tool)\n   554\t                    .map_err(dispatch_event_error)?;\n   555\t            }\n   556\t            EventKind::ToolEnd => {\n   557\t                let tool = event.tool.unwrap_or_else(|| \"tool\".to_string());\n   558\t                self.last_activity = format!(\"tool ended: {tool}\");\n   559\t                emitter.emit_tool_end(tool).map_err(dispatch_event_error)?;\n   560\t            }\n   561\t            EventKind::FileWrite => {\n   562\t                if let Some(path) = event.file {\n   563\t                    push_unique(&mut self.activity.files_changed, path.clone());\n   564\t                    self.last_activity = format!(\"file changed: {path}\");\n   565\t                    emitter\n   566\t                        .emit_file_write(path)\n   567\t                        .map_err(dispatch_event_error)?;\n   568\t                }\n   569\t            }\n   570\t            EventKind::FileRead => {\n   571\t                if let Some(path) = event.file {\n   572\t                    push_unique(&mut self.activity.files_read, path.clone());\n   573\t                    self.last_activity = format!(\"file read: {path}\");\n   574\t                    emitter.emit_file_read(path).map_err(dispatch_event_error)?;\n   575\t                }\n   576\t            }\n   577\t            EventKind::CommandRun => {\n   578\t                if let Some(command) = event.command {\n   579\t                    self.activity.commands_run.push(command.clone());\n   580\t                    self.last_activity = format!(\"command: {command}\");\n   581\t                    emitter\n   582\t                        .emit_command_run(command)\n   583\t                        .map_err(dispatch_event_error)?;\n   584\t                }\n   585\t            }\n   586\t            EventKind::Response => {\n   587\t                self.response_seen = true;\n   588\t                self.final_response = event.text;\n   589\t                self.last_activity = \"agent response\".to_string();\n   590\t            }\n   591\t            EventKind::TurnComplete => {\n   592\t                if let Some(tokens) = event.tokens {\n   593\t                    self.tokens.input += tokens.input;\n   594\t                    self.tokens.output += tokens.output;\n   595\t                    self.tokens.reasoning += tokens.reasoning;\n   596\t                    self.last_activity = \"turn completed\".to_string();\n   597\t                }\n   598\t            }\n   599\t            EventKind::TurnFailed => {\n   600\t                let message = event.text.unwrap_or_else(|| \"turn failed\".to_string());\n   601\t                self.last_activity = format!(\"turn failed: {message}\");\n   602\t                emitter\n   603\t                    .emit_error(\"turn_failed\", message)\n   604\t                    .map_err(dispatch_event_error)?;\n   605\t            }\n   606\t            EventKind::Error => {\n   607\t                let message = event.text.unwrap_or_else(|| \"codex error\".to_string());\n   608\t                self.last_activity = format!(\"error: {message}\");\n   609\t                emitter\n   610\t                    .emit_error(\"codex_error\", message)\n   611\t                    .map_err(dispatch_event_error)?;\n   612\t            }\n   613\t            EventKind::RawPassthrough => {\n   614\t                self.activity.parse_errors += 1;\n   615\t                self.last_activity = \"raw passthrough\".to_string();\n   616\t            }\n   617\t        }\n   618\t\n   619\t        Ok(())\n   620\t    }\n","exit_code":0,"status":"completed"}}
