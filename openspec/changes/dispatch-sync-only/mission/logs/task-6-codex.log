string(),\n            elapsed_s: Some(self.elapsed_s()),\n            last_activity: Some(last_activity.into()),\n            interval_s: Some(interval_s),\n            ..self.base_event()\n        })\n    }\n\n    fn emit(&self, event: DispatchEvent) -> Result<(), EventError> {\n        if !self.should_emit(&event.event_type) {\n            return Ok(());\n        }\n\n        let mut line = serde_json::to_vec(&event)?;\n        line.push(b'\\n');\n\n        let mut writer = self.writer.lock().expect(\"event writer mutex poisoned\");\n        writer.write_all(&line)?;\n        writer.flush()?;\n\n        Ok(())\n    }\n\n    fn should_emit(&self, _event_type: &str) -> bool {\n        match self.stream_mode {\n            StreamMode::Normal => true,\n        }\n    }\n\n    fn base_event(&self) -> DispatchEvent {\n        DispatchEvent {\n            event_type: String::new(),\n            dispatch_id: self.dispatch_id.clone(),\n            ts: Utc::now().to_rfc3339_opts(SecondsFormat::Secs, true),\n            elapsed_s: None,\n            last_activity: None,\n            interval_s: None,\n            engine: None,\n            model: None,\n            tool: None,\n            file: None,\n            command: None,\n            status: None,\n            duration_ms: None,\n            code: None,\n            message: None,\n        }\n    }\n\n    fn elapsed_s(&self) -> u64 {\n        self.start.elapsed().as_secs()\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use std::sync::{Arc, Mutex};\n\n    use serde_json::Value;\n\n    use super::*;\n\n    #[derive(Clone)]\n    struct SharedBuffer {\n        inner: Arc<Mutex<Vec<u8>>>,\n    }\n\n    impl Write for SharedBuffer {\n        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {\n            self.inner\n                .lock()\n                .expect(\"shared buffer mutex poisoned\")\n                .write(buf)\n        }\n\n        fn flush(&mut self) -> io::Result<()> {\n            Ok(())\n        }\n  