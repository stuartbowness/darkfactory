{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '900,1120p' tools/darkfactory-dispatch/src/engine.rs\"","aggregated_output":"error: Can't create the symlink for multishells at \"/run/user/1001/fnm_multishells/8_1782863737566\". Maybe there are some issues with permissions for the directory? Read-only file system (os error 30)\nstruct ControlFile {\n    #[serde(default)]\n    abort: bool,\n    #[serde(default)]\n    reason: Option<String>,\n}\n\nfn read_control_file(dir: &Path) -> Option<ControlFile> {\n    let text = std::fs::read_to_string(dir.join(\"control.json\")).ok()?;\n    serde_json::from_str(&text).ok()\n}\n\nfn effective_grace_sec(timeout_sec: u64, grace_sec: u64) -> u64 {\n    if grace_sec == 0 {\n        (timeout_sec / 2).max(1)\n    } else {\n        grace_sec\n    }\n}\n\nfn effective_heartbeat_sec(heartbeat_sec: u64) -> u64 {\n    if heartbeat_sec == 0 {\n        DEFAULT_HEARTBEAT_INTERVAL_SECS\n    } else {\n        heartbeat_sec\n    }\n}\n\nfn status_name(status: &DispatchStatus) -> &'static str {\n    match status {\n        DispatchStatus::Completed => \"completed\",\n        DispatchStatus::TimedOut => \"timed_out\",\n        DispatchStatus::Failed => \"failed\",\n    }\n}\n\nfn map_supervisor_error(error: SupervisorError) -> DispatchError {\n    match error {\n        SupervisorError::Spawn { program, message }\n            if program == \"codex\" && message.contains(\"No such file\") =>\n        {\n            DispatchError::BinaryNotFound\n        }\n        other => DispatchError::Other(other.to_string()),\n    }\n}\n\nfn dispatch_event_error(error: impl std::fmt::Display) -> DispatchError {\n    DispatchError::Other(format!(\"emit dispatch event: {error}\"))\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn codex_args_include_expected_flags() {\n        let spec = DispatchSpec {\n            model: \"gpt-5.5\".to_string(),\n            effort: Some(\"high\"