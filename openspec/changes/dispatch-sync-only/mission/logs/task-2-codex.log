{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' tools/darkfactory-dispatch/src/main.rs\"","aggregated_output":"error: Can't create the symlink for multishells at \"/run/user/1001/fnm_multishells/8_1782864308627\". Maybe there are some issues with permissions for the directory? Read-only file system (os error 30)\nuse std::process::ExitCode;\nuse std::sync::Arc;\n\nuse clap::Parser;\nuse ulid::Ulid;\n\nmod cli;\nmod engine;\nmod event;\nmod supervisor;\nmod types;\n\nuse cli::Cli;\nuse event::{Emitter, StreamMode};\nuse types::DispatchError;\n\nconst EXIT_DISPATCH_FAILURE: u8 = 1;\nconst EXIT_CLI_ERROR: u8 = 2;\n\n#[tokio::main]\nasync fn main() -> ExitCode {\n    match run().await {\n        Ok(code) => ExitCode::from(code),\n        Err((code, message)) => {\n            eprintln!(\"error: {message}\");\n            ExitCode::from(code)\n        }\n    }\n}\n\nasync fn run() -> Result<u8, (u8, String)> {\n    let cli = Cli::parse();\n\n    let json = cli.json;\n    let spec = cli.dispatch_spec().map_err(cli_error)?;\n    let dispatch_id = Ulid::new().to_string();\n    let emitter = Arc::new(Emitter::new(dispatch_id.clone(), StreamMode::Normal));\n\n    let result = match engine::dispatch(spec, dispatch_id.clone(), emitter).await {\n        Ok(result) => result,\n        Err(error) => {\n            let code = exit_code_for_engine_error(&error);\n            let result = cli::failed_start_result(dispatch_id, error.to_string());\n            cli::print_result(&result, true).map_err(cli_error)?;\n            eprintln!(\"error: {error}\");\n            return Ok(code);\n        }\n    };\n    cli::print_result(&result, json).map_err(cli_error)?;\n\n    Ok(cli::exit_code_for_result(&result))\n}\n\nfn cli_error(message: impl Into<String>) -> (u8, String) {\n    (EXIT_CLI_ERROR, message.into())\n}\n\nfn exit_code_for_engine_error(error: &DispatchError) -> u8 {\n    match error {\n        DispatchError::