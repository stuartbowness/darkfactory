status <dispatch-id>\n    45\t    darkfactory-dispatch wait <dispatch-id>\n    46\t    darkfactory-dispatch result <dispatch-id>\n    47\t\n    48\tRESULT JSON:\n    49\t    Sync mode (--json) emits a single JSON object on stdout:\n    50\t    {\\\"status\\\":\\\"completed|timed_out|failed\\\", \\\"dispatch_id\\\":\\\"...\\\",\n    51\t     \\\"duration_ms\\\":N, \\\"exit_code\\\":N, \\\"signal\\\":null,\n    52\t     \\\"output\\\":\\\"/path\\\", \\\"output_exists\\\":true,\n    53\t     \\\"tokens\\\":{\\\"input\\\":N,\\\"output\\\":N,\\\"reasoning\\\":N},\n    54\t     \\\"activity\\\":{\\\"files_changed\\\":[...],\\\"commands_run\\\":[...]}}\n    55\t\n    56\t    Async mode (--async) emits {\\\"kind\\\":\\\"async_started\\\",\\\"dispatch_id\\\":\\\"...\\\"}\n    57\t    then continues in the background. Use 'result <id>' to collect.\"\n    58\t)]\n    59\tpub(crate) struct Cli {\n    60\t    #[command(subcommand)]\n    61\t    pub(crate) command: Option<Commands>,\n    62\t\n    63\t    #[arg(long)]\n    64\t    pub(crate) model: Option<String>,\n    65\t\n    66\t    #[arg(long)]\n    67\t    pub(crate) effort: Option<String>,\n    68\t\n    69\t    #[arg(long, default_value = \"900\")]\n    70\t    pub(crate) timeout: u64,\n    71\t\n    72\t    #[arg(long)]\n    73\t    pub(crate) grace: Option<u64>,\n    74\t\n    75\t    #[arg(long, default_value_t = DEFAULT_HEARTBEAT_INTERVAL_SECS)]\n    76\t    pub(crate) heartbeat: u64,\n    77\t\n    78\t    #[arg(long, default_value = \"workspace-write\")]\n    79\t    pub(crate) sandbox: String,\n    80\t\n    81\t    #[arg(long = \"config\", num_args = 1)]\n    82\t    pub(crate) configs: Vec<String>,\n    83\t\n    84\t    #[arg(long, conflicts_with = \"prompt_file\")]\n    85\t    pub(crate) prompt: Option<String>,\n    86\t\n    87\t    #[arg(long, conflicts_with = \"prompt\")]\n    88\t    pub(crate) prompt_file: Option<PathBuf>,\n    89\t\n    90\t    #[arg(long)]\n    91\t    pub(crate) output: Option<PathBuf>,\n    92\t\n    93\t    #[arg(long)]\n    94\t    pub(crate) cwd: Option<PathBuf>,\n    95\t\n    96\t    #[arg(long)]\n    97\t    pub(crate) log: Option<PathBuf>,\n    98\t\n    99\t    #[arg(long, conflicts_with = \"async_mode\")]\n   100\t    pub(crate) json: bool,\n   101\t\n   102\t    #[arg(long = \"async\", conflicts_with = \"json\")]\n   103\t    pub(crate) async_mode: bool,\n   104\t}\n   105\t\n   106\t#[derive(Subcommand)]\n   107\tpub(crate) enum Commands {\n   108\t    Status { id: String },\n   109\t    Result { id: String },\n   110\t    Wait { id: String },\n   111\t}\n   112\t\n   113\timpl Cli {\n   114\t    pub(crate) fn dispatch_spec(self) -> Result<DispatchSpec, String> {\n   115\t        if self.heartbeat == 0 {\n   116\t            return Err(\"--heartbeat must be greater than 0\".to_string());\n   117\t        }\n   118\t\n   119\t        let prompt = match (self.prompt, self.prompt_file) {\n   120\t            (Some(prompt), None) => prompt,\n   121\t            (None, Some(path)) => fs::read_to_string(&path)\n   122\t                .map_err(|error| format!(\"read prompt file {}: {error}\", path.display()))?,\n   123\t            (None, None) => {\n   124\t                return Err(\"missing prompt: provide --prompt or --prompt-file\".to_string());\n   125\t            }\n   126\t            (Some(_), Some(_)) => {\n   127\t                return Err(\"--prompt and --prompt-file cannot be used together\".to_string());\n   128\t            }\n   129\t        };\n   130\t\n","exit_code":0,"status":"completed"}}
