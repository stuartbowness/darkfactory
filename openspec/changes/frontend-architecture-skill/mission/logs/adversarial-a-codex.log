ntend/TESTING.md && git diff --cached --check -- skills/frontend/PATTERNS.md skills/frontend/TESTING.md && git diff --cached --stat -- skills/frontend/PATTERNS.md skills/frontend/TESTING.md'\",\"aggregated_output\":\" skills/frontend/PATTERNS.md | 155 ++++++++++++++++++++++++++++++++++++++++++++\\n skills/frontend/TESTING.md  |  73 +++++++++++++++++++++\\n 2 files changed, 228 insertions(+)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"tool_end\",\"dispatch_id\":\"01KQR3P1JZMY30DGRE9CM15A0W\",\"ts\":\"2026-05-03T23:46:39Z\",\"tool\":\"command_execution\"}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git diff --cached -- skills/frontend/PATTERNS.md skills/frontend/TESTING.md'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"command_run\",\"dispatch_id\":\"01KQR3P1JZMY30DGRE9CM15A0W\",\"ts\":\"2026-05-03T23:46:43Z\",\"command\":\"/bin/zsh -lc 'git diff --cached -- skills/frontend/PATTERNS.md skills/frontend/TESTING.md'\"}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git diff --cached -- skills/frontend/PATTERNS.md skills/frontend/TESTING.md'\",\"aggregated_output\":\"diff --git a/skills/frontend/PATTERNS.md b/skills/frontend/PATTERNS.md\\nnew file mode 100644\\nindex 0000000..c733845\\n--- /dev/null\\n+++ b/skills/frontend/PATTERNS.md\\n@@ -0,0 +1,155 @@\\n+# Frontend Patterns\\n+\\n+Use these examples as reference points when applying the deep-component rules from [DEEP-COMPONENTS.md](DEEP-COMPONENTS.md).\\n+\\n+## Deep Component Examples\\n+\\n+### FilesDrawer - small prop interface owning a workflow\\n+\\n+Rule: Small Semantic Interfaces + Collapse Coordination\\n+\\n+Source: `~/Code/toyo` file management drawer\\n+\\n+```typescript\\n+interface FilesDrawerProps {\\n+  open: boolean\\n+  onClose: () => void\\n+  mode?: \\\"drawer\\\" | \\\"page\\\"\\n+}\\n+```\\n+\\n+Three props, two semantic events. The component owns file upload, delete, directory navigation, drag-drop, and folder creation internally. The parent only knows \\\"open/close\\\" and \\\"drawer or page mode.\\\"\\n+\\n+### BrowserPane - derives state from props\\n+\\n+Rule: Derive Don't Sync\\n+\\n+Source: `~/Code/toyo` browser preview pane\\n+\\n+```typescript\\n+const iframeUrl = useMemo(\\n+  () => buildLiveViewUrl(browserSession.liveViewUrl, readOnlyMode),\\n+  [browserSession.liveViewUrl, readOnlyMode],\\n+)\\n+```\\n+\\n+The iframe URL is derived during render via `useMemo`, not stored in state and synced with `useEffect`. The component has about 8 props, but they describe one concept: browser session display.\\n+\\n+## Allowed-Shallow Examples\\n+\\n+### Button - design system leaf\\n+\\n+Rule: Allowed-shallow exception - design system leaf\\n+\\n+Source: `~/Code/toyo` UI primitives\\n+\\n+```tsx\\n+function Button({\\n+  className,\\n+  variant = \\\"default\\\",\\n+  size = \\\"default\\\",\\n+  asChild = false,\\n+  ...props\\n+}: ButtonProps) {\\n+  const Comp = asChild ? Slot.Root : \\\"button\\\"\\n+  return (\\n+    <Comp\\n+      data-slot=\\\"button\\\"\\n+      className={cn(buttonVariants({ variant, size, className }))}\\n+      {...props}\\n+    />\\n+  )\\n+}\\n+```\\n+\\n+Zero logic. CVA handles variants, Slot handles polymorphism, and the rest spread passes button attributes through. This is intentionally shallow. Its job is visual consistency, not workflow ownership.\\n+\\n+### Card + CardHeader - compound component pattern\\n+\\n+Rule: Composition over Configuration, design system side\\n+\\n+Source: `~/Code/toyo` UI primitives\\n+\\n+```tsx\\n+function Card({ className, ...props }: React.ComponentProps<\\\"div\\\">) {\\n+  return (\\n+    <div\\n+      data-slot=\\\"card\\\"\\n+      className={cn(\\\"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm\\\", className)}\\n+      {...props}\\n+    />\\n+  )\\n+}\\n+\\n+function CardHeader({ className, ...props }: React.ComponentProps<\\\"div\\\">) {\\n+  return (\\n+    <div\\n+      data-slot=\\\"card-header\\\"\\n+      className={cn(\\\"@container/card-header grid auto-rows-min ...\\\", className)}\\n+      {...props}\\n+    />\\n+  )\\n+}\\n+```\\n+\\n+Each sub-component is a thin wrapper. Callers compose: `<Card><CardHeader>...</CardHeader><CardContent>...</CardContent></Card>`. No config objects.\\n+\\n+## Hook Pattern - Derive Don't Sync\\n+\\n+### useChatScroll - pure function derives from DOM\\n+\\n+Rule: Derive Don't Sync\\n+\\n+Source: `~/Code/toyo` chat scroll behavior\\n+\\n+```typescript\\n+export function isAtBottomPosition(\\n+  element: Pick<HTMLDivElement, \\\"scrollHeight\\\" | \\\"scrollTop\\\" | \\\"clientHeight\\\">\\n+): boolean {\\n+  return element.scrollHeight - element.scrollTop - element.clientHeight < AT_BOTTOM_THRESHOLD\\n+}\\n+\\n+// Inside useChatScroll:\\n+function onScroll() {\\n+  const el = scrollRef.current\\n+  if (!el) return\\n+  const atBottom = isAtBottomPosition(el)\\n+  isBottomLockedRef.current = getNextBottomLockState({\\n+    atBottom,\\n+    nextScrollTop: el.scrollTop,\\n+    previousScrollTop: previousScrollTopRef.current,\\n+    wasLocked: isBottomLockedRef.current,\\n+    isUserScrollUp: recentUserScrollIntentRef.current === \\\"up\\\",\\n+  })\\n+  setIsAtBottom(atBottom)\\n+}\\n+```\\n+\\n+Pure function computes `isAtBottom` from DOM measurements. Lock state lives in a ref, not `useState`. Display state, `isAtBottom`, is the only `useState`; it is the minimal state needed for rendering.\\n+\\n+## Anti-Pattern with Fix\\n+\\n+### Anti-pattern: useEffect syncing derived state\\n+\\n+```typescript\\n+// BAD: syncing a pure derivation via useEffect\\n+const [isAtBottom, setIsAtBottom] = useState(false)\\n+\\n+useEffect(() => {\\n+  setIsAtBottom(\\n+    scrollRef.current.scrollHeight -\\n+    scrollRef.current.scrollTop -\\n+    scrollRef.current.clientHeight < 50\\n+  )\\n+}, [scrollRef.current?.scrollHeight])\\n+```\\n+\\n+Why it is wrong: this derives state in an effect with incomplete dependency tracking. It creates stale closures, triggers unnecessary renders, and races with scroll events.\\n+\\n+Fix: extract the pure function and call it in the scroll handler.\\n+\\n+```typescript\\n+// GOOD: pure function called on demand\\n+const atBottom = isAtBottomPosition(scrollRef.current)\\n+setIsAtBottom(atBottom)\\n+```\\ndiff --git a/skills/frontend/TESTING.md b/skills/frontend/TESTING.md\\nnew file mode 100644\\nindex 0000000..1386fdb\\n--- /dev/null\\n+++ b/skills/frontend/TESTING.md\\n@@ -0,0 +1,73 @@\\n+# Frontend Testing\\n+\\n+## Core Principle\\n+\\n+Test what users see and do, not how the component works internally.\\n+\\n+Frontend tests should read like behavior specs. A good test says a user can open a menu, submit a form, see an error, or trigger a semantic callback. It should not care whether the component uses local state, a hook, a reducer, or extracted child components.\\n+\\n+## How to Test Components\\n+\\n+Render the component with realistic props.\\n+\\n+```tsx\\n+render(<FilesDrawer open onClose={onClose} mode=\\\"drawer\\\" />)\\n+```\\n+\\n+Query by role, label, or visible text.\\n+\\n+```tsx\\n+screen.getByRole(\\\"button\\\", { name: /new folder/i })\\n+screen.getByLabelText(/file name/i)\\n+screen.getByText(/uploads/i)\\n+```\\n+\\n+Use `userEvent` for real interaction. Prefer `click`, `type`, and `tab` over `fireEvent`.\\n+\\n+```tsx\\n+const user = userEvent.setup()\\n+\\n+await user.click(screen.getByRole(\\\"button\\\", { name: /new folder/i }))\\n+await user.type(screen.getByLabelText(/folder name/i), \\\"Reports\\\")\\n+await user.click(screen.getByRole(\\\"button\\\", { name: /create/i }))\\n+```\\n+\\n+Assert visible outcomes and semantic events.\\n+\\n+```tsx\\n+expect(screen.getByText(\\\"Reports\\\")).toBeVisible()\\n+expect(onClose).not.toHaveBeenCalled()\\n+```\\n+\\n+## What Not to Test\\n+\\n+Do not test prop plumbing. A test that only proves a parent passes `foo` to a child will break when the component is deepened without proving behavior changed.\\n+\\n+Do not test hook calls. Avoid assertions such as \\\"useEffect fired\\\" or \\\"useState was set.\\\" Test the rendered result or semantic callback instead.\\n+\\n+Do not test internal state names or values. State is an implementation detail.\\n+\\n+Do not test class names or Tailwind utility classes. Use visual verification for layout and styling behavior.\\n+\\n+Do not use snapshot tests for layout. Snapshots are noisy for frontend structure and weak at proving what users can see or do.\\n+\\n+## Hook Logic Boundary\\n+\\n+Complex hook logic belongs in separate `/tdd` tasks when it has validation, state machines, data transformation, or other behavior that can be tested through a non-rendering interface.\\n+\\n+Component tests should not re-test hook internals. They should test the visible behavior that results from the hook.\\n+\\n+For example, a hook test can prove the state machine chooses the next chat scroll lock state. A component test should prove the scroll control appears, disappears, or responds to user action in the rendered UI.\\n+\\n+## Test Survival Rule\\n+\\n+A good test survives refactoring that preserves behavior.\\n+\\n+If renaming internal state, extracting a sub-component, or switching from local state to a hook breaks the test, the test was coupled to implementation.\\n+\\n+Before keeping a component test, ask:\\n+\\n+- Would this still pass if the component had different private state names?\\n+- Would this still pass if part of the UI moved into a child component?\\n+- Would this still pass if state moved from `useState` to a tested hook?\\n+- Does this fail when a user-visible behavior actually breaks?\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"tool_end\",\"dispatch_id\":\"01KQR3P1JZMY30DGRE9CM15A0W\",\"ts\":\"2026-05-03T23:46:43Z\",\"tool\":\"command_execution\"}\n+{\"type\":\"item.started\",\"item\":{\"id\":\"item_23\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git diff --cached --name-only && git status --short'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n+{\"type\":\"command_run\",\"dispatch_id\":\"01KQR3P1JZMY30DGRE9CM15A0W\",\"ts\":\"2026-05-03T23:46:46Z\",\"command\":\"/bin/zsh -lc 'git diff --cached --name-only && git status --short'\"}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_23\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git diff --cached --name-only && git status --short'\",\"aggregated_output\":\"skills/frontend/PATTERNS.md\\nskills/frontend/TESTING.md\\n M UBIQUITOUS_LANGUAGE.md\\nA  skills/frontend/PATTERNS.md\\nA  skills/frontend/TESTING.md\\n?? openspec/changes/frontend-architecture-skill/.openspec.yaml\\n?? openspec/changes/frontend-architecture-skill/contract.md\\n?? openspec/changes/frontend-architecture-skill/coverage-audit.md\\n?? openspec/changes/frontend-architecture-skill/design.md\\n?? openspec/changes/frontend-architecture-skill/mission/briefs/\\n?? openspec/changes/frontend-architecture-skill/mission/config.yaml\\n?? openspec/changes/frontend-architecture-skill/mission/handoffs/\\n?? openspec/changes/frontend-architecture-skill/mission/logs/\\n?? openspec/changes/frontend-architecture-skill/mission/progress.md\\n?? openspec/changes/frontend-architecture-skill/mission/validations/\\n?? openspec/changes/frontend-architecture-skill/proposal.md\\n?? openspec/changes/frontend-architecture-skill/specs/\\n?? openspec/changes/frontend-architecture-skill/tasks.md\\n?? openspec/changes/user-friendly-contract-language/.openspec.yaml\\n?? openspec/changes/user-friendly-contract-language/contract.md\\n?? openspec/changes/user-friendly-contract-language/coverage-audit.md\\n?? openspec/changes/user-friendly-contract-language/design.md\\n?? openspec/changes/user-friendly-contract-language/mission/briefs/\\n?? openspec/changes/u