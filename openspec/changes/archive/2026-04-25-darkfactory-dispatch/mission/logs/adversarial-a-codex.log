+    let json = cli.json;
+    let spec = cli.dispatch_spec().map_err(cli_error)?;
+    let dispatch_id = Ulid::new().to_string();
+    let emitter = Arc::new(Emitter::new(dispatch_id.clone(), StreamMode::Normal));
