+    );
+    let result_json: Value = serde_json::from_slice(&result.stdout)?;
+    assert_eq!(result_json["status"], "completed");
+    assert_eq!(result_json["dispatch_id"], dispatch_id);
+
+    assert!(child.wait()?.success());
+    assert!(env
+        .home
+        .join(".darkfactory/dispatches")
+        .join(dispatch_id)
+        .join("events.jsonl")
+        .exists());
+
+    Ok(())
+}
