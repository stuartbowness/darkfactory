+pub(crate) fn dispatch_store_root() -> Result<PathBuf, String> {
+    let home = std::env::var_os("HOME").ok_or_else(|| "HOME is not set".to_string())?;
+    Ok(PathBuf::from(home).join(".darkfactory").join("dispatches"))
+}
