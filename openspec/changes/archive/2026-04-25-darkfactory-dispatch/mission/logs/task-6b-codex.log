  if [[ "$1" == "-o" && $# -ge 2 ]]; then
    output="$2"
    shift 2
    continue
  fi
  shift
done

mode="${CODEX_MOCK_MODE:-success}"
if [[ -n "${CODEX_MOCK_PID_FILE:-}" ]]; then
  echo "$$" > "${CODEX_MOCK_PID_FILE}"
fi

write_output() {
