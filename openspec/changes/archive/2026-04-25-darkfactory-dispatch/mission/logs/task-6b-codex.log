+        std::fs::copy(source, &target)?;
+        let mut permissions = std::fs::metadata(&target)?.permissions();
+        permissions.set_mode(0o755);
+        std::fs::set_permissions(&target, permissions)?;
+        Ok(Self { home, bin_dir })
+    }
