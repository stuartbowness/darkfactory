+    let stdout = child.stdout.take().expect("stdout piped");
+    let mut lines = BufReader::new(stdout).lines();
+    let ack: Value = serde_json::from_str(&lines.next().expect("ack line")?)?;
+    assert_eq!(ack["kind"], "async_started");
