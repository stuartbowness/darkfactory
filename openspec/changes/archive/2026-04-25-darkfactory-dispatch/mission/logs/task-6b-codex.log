+        exit_code: None,
+        signal: None,
+        output: None,
+        output_exists: false,
+        error: Some(DispatchErrorInfo {
+            code: "startup_failed".to_string(),
+            message,
+            retryable: true,
+        }),
+        tokens: Default::default(),
+        activity: Default::default(),
+    }
+}
