+        }
+        match host_process_state(&store_dir)? {
+            HostProcessState::Dead => return Err(format!("dispatch {id} is orphaned")),
+            HostProcessState::Missing => return Err(format!("dispatch not found: {id}")),
+            HostProcessState::Running => {}
+        }
+
