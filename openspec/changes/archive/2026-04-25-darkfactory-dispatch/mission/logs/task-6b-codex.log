+            elapsed_s: Some(result.duration_ms / 1000),
+            last_activity: Some("done".to_string()),
+            tools_used: Some(result.activity.tool_calls),
+            files_changed: Some(result.activity.files_changed.len() as u64),
+            result: Some(result),
+        });
+    }
