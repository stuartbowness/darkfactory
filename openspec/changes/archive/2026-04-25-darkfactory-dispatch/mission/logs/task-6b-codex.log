+fn temp_test_dir(name: &str) -> std::io::Result<PathBuf> {
+    let id = TEST_ID.fetch_add(1, Ordering::Relaxed);
+    let path = std::env::temp_dir().join(format!(
+        "darkfactory-dispatch-cli-{}-{name}-{id}",
