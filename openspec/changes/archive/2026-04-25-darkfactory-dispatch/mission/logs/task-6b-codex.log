+struct LifecycleStatus {
+    state: String,
+    dispatch_id: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    elapsed_s: Option<u64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
