+    fn dispatch_command(&self) -> StdCommand {
+        let mut command = StdCommand::new(env!("CARGO_BIN_EXE_darkfactory-dispatch"));
+        let path = std::env::var("PATH").unwrap_or_default();
+        command
+            .env("HOME", &self.home)
+            .env("PATH", format!("{}:{path}", self.bin_dir.display()));
+        command
+    }
