+fn status_name(status: &DispatchStatus) -> &'static str {
+    match status {
+        DispatchStatus::Completed => "completed",
+        DispatchStatus::TimedOut => "timed_out",
+        DispatchStatus::Failed => "failed",
+    }
+}
