+pub(crate) fn exit_code_for_result(result: &DispatchResult) -> u8 {
+    match result.status {
+        DispatchStatus::Completed => 0,
+        DispatchStatus::Failed | DispatchStatus::TimedOut => 1,
+    }
+}
