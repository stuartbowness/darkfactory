+use clap::Parser;
+
+#[derive(Parser)]
+#[command(
+    name = "darkfactory-dispatch",
+    version,
+    about = "Process supervisor for Codex CLI subprocesses"
+)]
+struct Cli {
+    #[command(subcommand)]
+    command: Option<Commands>,
+}
+
+#[derive(clap::Subcommand)]
+enum Commands {
+    Status { id: String },
+    Result { id: String },
+    Wait { id: String },
+}
+
+#[tokio::main]
+async fn main() {
+    let _cli = Cli::parse();
+    println!("darkfactory-dispatch stub");
+}
