+
+    pub(crate) fn stderr(&self) -> Result<ChildStderr, SupervisorError> {
+        self.inner
+            .stderr
+            .lock()
+            .expect("stderr mutex poisoned")
+            .take()
+            .ok_or(SupervisorError::StderrUnavailable)
+    }
