+#[derive(Debug, Clone)]
+pub(crate) struct RunHandle {
+    inner: Arc<RunState>,
+}
+
+#[derive(Debug)]
+struct RunState {
+    pid: u32,
+    pgid: i32,
+    stdout: Mutex<Option<ChildStdout>>,
+    stderr: Mutex<Option<ChildStderr>>,
+    wait_rx: watch::Receiver<Option<Result<ExitResult, SupervisorError>>>,
+}
+
+impl RunHandle {
+    pub(crate) fn pid(&self) -> u32 {
