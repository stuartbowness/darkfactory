+
+fn process_group_id(pid: u32) -> i32 {
+    // SAFETY: getpgid is called with a live child pid returned by spawn.
+    let pgid = unsafe { libc::getpgid(pid as libc::pid_t) };
+    if pgid > 0 {
+        pgid
+    } else {
+        pid as i32
