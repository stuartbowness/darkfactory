+impl SupervisorBuilder {
+    pub(crate) fn new(binary: impl AsRef<OsStr>) -> Self {
+        Self {
+            binary: binary.as_ref().to_os_string(),
+            args: Vec::new(),
+            cwd: None,
+            env: Vec::new(),
+            stdin: StdinMode::Null,
