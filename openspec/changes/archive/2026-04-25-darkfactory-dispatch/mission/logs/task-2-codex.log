+            // this blocking call. A null timeout means wait until parent exit.
+            let n = unsafe { libc::kevent(kq, &change, 1, &mut event, 1, std::ptr::null()) };
+            // SAFETY: kq is a descriptor returned by kqueue above.
+            let _ = unsafe { libc::close(kq) };
