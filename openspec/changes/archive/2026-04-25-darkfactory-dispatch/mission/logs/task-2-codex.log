+    pub(crate) async fn wait(&self) -> Result<ExitResult, SupervisorError> {
+        let mut rx = self.inner.wait_rx.clone();
+        loop {
+            let result = { rx.borrow().clone() };
+            if let Some(result) = result {
+                return result;
+            }
+            rx.changed()
+                .await
