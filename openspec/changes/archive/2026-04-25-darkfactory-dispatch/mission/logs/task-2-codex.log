+    #[error("send signal {signal} to process group {pgid}: {message}")]
+    Signal {
+        signal: i32,
+        pgid: i32,
+        message: String,
+    },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct ExitResult {
+    pub(crate) code: Option<i32>,
+    pub(crate) signal: Option<i32>,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub(crate) enum StdinMode {
+    Null,
+    Piped,
+}
+
+#[derive(Debug)]
+pub(crate) struct SupervisorBuilder {
+    binary: OsString,
+    args: Vec<OsString>,
+    cwd: Option<PathBuf>,
+    env: Vec<(OsString, OsString)>,
+    stdin: StdinMode,
+    parent_death_watch: bool,
+}
+
+impl SupervisorBuilder {
+    pub(crate) fn new(binary: impl AsRef<OsStr>) -> Self {
+        Self {
+            binary: binary.as_ref().to_os_string(),
+            args: Vec::new(),
+            cwd: None,
+            env: Vec::new(),
+            stdin: StdinMode::Null,
+            parent_death_watch: true,
+        }
+    }
+
+    pub(crate) fn arg(mut self, arg: impl AsRef<OsStr>) -> Self {
+        self.args.push(arg.as_ref().to_os_string());
+        self
+    }
+
+    pub(crate) fn args<I, S>(mut self, args: I) -> Self
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<OsStr>,
+    {
+        self.args
+            .extend(args.into_iter().map(|arg| arg.as_ref().to_os_string()));
+        self
+    }
+
+    pub(crate) fn current_dir(mut self, cwd: impl AsRef<Path>) -> Self {
+        self.cwd = Some(cwd.as_ref().to_path_buf());
+        self
+    }
+
+    pub(crate) fn env(mut self, key: impl AsRef<OsStr>, value: impl AsRef<OsStr>) -> Self {
+        self.env.push((
+            key.as_ref().to_os_string(),
+            value.as_ref().to_os_string(),
+        ));
+        self
+    }
+
+    pub(crate) fn stdin(mut self, stdin: StdinMode) -> Self {
+        self.stdin = stdin;
+        self
+    }
+
+    pub(crate) fn parent_death_watch(mut self, enabled: bool) -> Self {
+        self.parent_death_watch = enabled;
+        self
+    }
+
+    pub(crate) fn spawn(self) -> Result<RunHandle, SupervisorError> {
+        let program = self.binary.to_string_lossy().into_owned();
+        let mut command = Command::new(&self.binary);
+        command.args(&self.args);
+        command.stdin(match self.stdin {
+            StdinMode::Null => Stdio::null(),
+            StdinMode::Piped => Stdio::piped(),
+        });
+        command.stdout(Stdio::piped());
+        command.stderr(Stdio::piped());
+
+        if let Some(cwd) = self.cwd {
+            command.current_dir(cwd);
+        }
+        for (key, value) in self.env {
+            command.env(key, value);
+        }
+
+        // SAFETY: This runs in the child process after fork and before exec.
+        // Only async-signal-safe libc calls are made here.
+        unsafe {
+            command.pre_exec(|| {
+                if libc::setpgid(0, 0) != 0 {
+                    return Err(io::Error::last_os_error());
+                }
+
+                #[cfg(target_os = "linux")]
+                {
+                    if libc::prctl(libc::PR_SET_PDEATHSIG, libc::SIGKILL) != 0 {
+                        return Err(io::Error::last_os_error());
+                    }
+                }
+
+                Ok(())
+            });
+        }
+
+        let mut child = command.spawn().map_err(|error| SupervisorError::Spawn {
+            program,
+            message: error.to_string(),
+        })?;
+
+        let pid = child.id().ok_or(SupervisorError::MissingPid)?;
+        let pgid = process_group_id(pid);
+        let stdout = child
+            .stdout
+            .take()
+            .ok_or(SupervisorError::StdoutUnavailable)?;
+        let stderr = child
+            .stderr
+            .take()
+            .ok_or(SupervisorError::StderrUnavailable)?;
+
+        if self.parent_death_watch {
+            watch_parent_death(pgid);
+        }
+
+        let (wait_tx, wait_rx) = watch::channel(None);
+        tokio::spawn(async move {
+            let result = child
+                .wait()
+                .await
+                .map(|status| ExitResult {
+                    code: status.code(),
+                    signal: status.signal(),
+                })
+                .map_err(|error| SupervisorError::Wait(error.to_string()));
+            let _ = wait_tx.send(Some(result));
+        });
+
+        Ok(RunHandle {
+            inner: Arc::new(RunState {
+                pid,
+                pgid,
+                stdout: Mutex::new(Some(stdout)),
+                stderr: Mutex::new(Some(stderr)),
+                wait_rx,
+            }),
+        })
+    }
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct RunHandle {
+    inner: Arc<RunState>,
+}
+
+#[derive(Debug)]
+struct RunState {
+    pid: u32,
+    pgid: i32,
+    stdout: Mutex<Option<ChildStdout>>,
+    stderr: Mutex<Option<ChildStderr>>,
+    wait_rx: watch::Receiver<Option<Result<ExitResult, SupervisorError>>>,
+}
+
+impl RunHandle {
+    pub(crate) fn pid(&self) -> u32 {
+        self.inner.pid
+    }
+
+    pub(crate) fn stdout(&self) -> Result<ChildStdout, SupervisorError> {
+        self.inner
+            .stdout
+            .lock()
+            .expect("stdout mutex poisoned")
+            .take()
+            .ok_or(SupervisorError::StdoutUnavailable)
+    }
+
+    pub(crate) fn stderr(&self) -> Result<ChildStderr, SupervisorError> {
+        self.inner
+            .stderr
+            .lock()
+            .expect("stderr mutex poisoned")
+            .take()
+            .ok_or(SupervisorError::StderrUnavailable)
+    }
+
+    pub(crate) async fn wait(&self) -> Result<ExitResult, SupervisorError> {
+        let mut rx = self.inner.wait_rx.clone();
+        loop {
+            if let Some(result) = rx.borrow().clone() {
+                return result;
+            }
+            rx.changed()
+                .await
+                .map_err(|_| SupervisorError::WaitChannelClosed)?;
+        }
+    }
+
+    pub(crate) async fn graceful_stop(
+        &self,
+        grace_secs: u64,
+    ) -> Result<ExitResult, SupervisorError> {
+        signal_group(self.inner.pgid, libc::SIGTERM)?;
+
+        tokio::select! {
+            result = self.wait() => result,
+            () = tokio::time::sleep(Duration::from_secs(grace_secs)) => {
+                self.kill()?;
+                self.wait().await
+            }
+        }
+    }
+
+    pub(crate) fn kill(&self) -> Result<(), SupervisorError> {
+        signal_group(self.inner.pgid, libc::SIGKILL)
+    }
+}
+
+fn process_group_id(pid: u32) -> i32 {
+    // SAFETY: getpgid is called with a live child pid returned by spawn.
+    let pgid = unsafe { libc::getpgid(pid as libc::pid_t) };
+    if pgid > 0 {
+        pgid
+    } else {
+        pid as i32
+    }
+}
+
+fn signal_group(pgid: i32, signal: i32) -> Result<(), SupervisorError> {
+    if pgid <= 0 {
+        return Ok(());
+    }
+
+    // SAFETY: Negative pid targets the process group. ESRCH is harmless here
+    // because it means the group has already exited.
+    let rc = unsafe { libc::kill(-pgid, signal) };
+    if rc == 0 {
+        return Ok(());
+    }
+
+    let error = io::Error::last_os_error();
+    if error.raw_os_error() == Some(libc::ESRCH) {
+        return Ok(());
+    }
+
+    Err(SupervisorError::Signal {
+        signal,
+        pgid,
+        message: error.to_string(),
+    })
+}
+
+#[cfg(target_os = "macos")]
+pub(crate) fn watch_parent_death(pgid: i32) {
+    let parent_pid = unsafe { libc::getppid() };
+    if parent_pid <= 1 {
+        return;
+    }
+
+    let _ = tokio::task::spawn_blocking(move || {
+        // SAFETY: kqueue returns a process-local descriptor or -1 on failure.
+        let kq = unsafe { libc::kqueue() };
+        if kq < 0 {
+            return;
+        }
+
+        let change = libc::kevent {
+            ident: parent_pid as libc::uintptr_t,
+            filter: libc::EVFILT_PROC,
+            flags: (libc::EV_ADD | libc::EV_ONESHOT) as libc::c_ushort,
+            fflags: libc::NOTE_EXIT,
+            data: 0,
+            udata: std::ptr::null_mut(),
+        };
+        let mut event = libc::kevent {
+            ident: 0,
+            filter: 0,
+            flags: 0,
+            fflags: 0,
+            data: 0,
+            udata: std::ptr::null_mut(),
+        };
+
+        // SAFETY: Pointers refer to valid kevent structs for the duration of
+        // this blocking call. A null timeout means wait until parent exit.
+        let n = unsafe {
+            libc::kevent(
+                kq,
+                &change,
+                1,
+                &mut event,
+                1,
+                std::ptr::null(),
+            )
+        };
+        // SAFETY: kq is a descriptor returned by kqueue above.
+        let _ = unsafe { libc::close(kq) };
+
+        if n > 0 {
+            let _ = signal_group(pgid, libc::SIGKILL);
+        }
+    });
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn watch_parent_death(_pgid: i32) {
+    // SAFETY: prctl with PR_SET_PDEATHSIG only changes the current process'
+    // parent-death signal. Errors are best-effort and intentionally ignored.
+    let _ = unsafe { libc::prctl(libc::PR_SET_PDEATHSIG, libc::SIGKILL) };
+}
+
+#[cfg(not(any(target_os = "macos", target_os = "linux")))]
+pub(crate) fn watch_parent_death(_pgid: i32) {}
diff --git a/tools/darkfactory-dispatch/tests/supervisor.rs b/tools/darkfactory-dispatch/tests/supervisor.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b63863718b7c13782b6bdce47d811a44a4405a5b
--- /dev/null
+++ b/tools/darkfactory-dispatch/tests/supervisor.rs
@@ -0,0 +1,99 @@
+#[expect(dead_code, reason = "integration tests exercise this module boundary directly")]
+#[path = "../src/supervisor.rs"]
+mod supervisor;
+
+use std::io;
+use std::time::{Duration, Instant};
+
+use nix::libc;
+use supervisor::SupervisorBuilder;
+use tokio::io::{AsyncBufReadExt, BufReader};
+
+#[tokio::test(flavor = "multi_thread")]
+async fn kill_terminates_the_whole_process_group() -> Result<(), Box<dyn std::error::Error>> {
+    let script = "sleep 300 & bg=$!; sleep 300 & fg=$!; echo $$ $bg $fg; wait";
+    let handle = SupervisorBuilder::new("sh")
+        .args(["-c", script])
+        .spawn()?;
+
+    let mut lines = BufReader::new(handle.stdout()?).lines();
+    let line = tokio::time::timeout(Duration::from_secs(2), lines.next_line())
+        .await??
+        .ok_or("child did not print process ids")?;
+    let pids = parse_pids(&line)?;
+    assert_eq!(pids.len(), 3);
+
+    handle.kill()?;
+    let result = handle.wait().await?;
+
+    assert_eq!(result.signal, Some(libc::SIGKILL));
+    for pid in pids {
+        assert_process_exits(pid).await?;
+    }
+
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn graceful_stop_kills_after_grace_when_sigterm_is_ignored(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let handle = SupervisorBuilder::new("sh")
+        .args(["-c", "trap '' TERM; while true; do sleep 1; done"])
+        .spawn()?;
+
+    let started = Instant::now();
+    let result = handle.graceful_stop(1).await?;
+    let elapsed = started.elapsed();
+
+    assert_eq!(result.signal, Some(libc::SIGKILL));
+    assert!(elapsed >= Duration::from_secs(1));
+    assert!(elapsed < Duration::from_secs(3));
+
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn wait_reports_sigterm_and_sigkill() -> Result<(), Box<dyn std::error::Error>> {
+    let term_handle = SupervisorBuilder::new("sleep").arg("300").spawn()?;
+    let term_result = term_handle.graceful_stop(10).await?;
+    assert_eq!(term_result.signal, Some(libc::SIGTERM));
+    assert_eq!(term_handle.wait().await?, term_result);
+
+    let kill_handle = SupervisorBuilder::new("sleep").arg("300").spawn()?;
+    kill_handle.kill()?;
+    let kill_result = kill_handle.wait().await?;
+    assert_eq!(kill_result.signal, Some(libc::SIGKILL));
+
+    Ok(())
+}
+
+fn parse_pids(line: &str) -> Result<Vec<i32>, Box<dyn std::error::Error>> {
+    line.split_whitespace()
+        .map(str::parse::<i32>)
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(Into::into)
+}
+
+async fn assert_process_exits(pid: i32) -> Result<(), Box<dyn std::error::Error>> {
+    let deadline = Instant::now() + Duration::from_secs(3);
+    loop {
+        if !process_exists(pid) {
+            return Ok(());
+        }
+        if Instant::now() >= deadline {
+            return Err(format!("process {pid} still exists").into());
+        }
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+}
+
+fn process_exists(pid: i32) -> bool {
+    // SAFETY: kill(pid, 0) does not send a signal. It only checks whether the
+    // process exists and whether this process can signal it.
+    let rc = unsafe { libc::kill(pid, 0) };
+    if rc == 0 {
+        return true;
+    }
+
+    io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)
+}

