+            result = self.wait() => result,
+            () = tokio::time::sleep(Duration::from_secs(grace_secs)) => {
+                self.kill()?;
+                self.wait().await
+            }
+        }
+    }
+
+    pub(crate) fn kill(&self) -> Result<(), SupervisorError> {
+        signal_group(self.inner.pgid, libc::SIGKILL)
+    }
