+#[cfg(target_os = "macos")]
+pub(crate) fn watch_parent_death(pgid: i32) {
+    let parent_pid = unsafe { libc::getppid() };
+    if parent_pid <= 1 {
+        return;
+    }
+
+    let _ = tokio::task::spawn_blocking(move || {
+        // SAFETY: kqueue returns a process-local descriptor or -1 on failure.
+        let kq = unsafe { libc::kqueue() };
+        if kq < 0 {
+            return;
+        }
