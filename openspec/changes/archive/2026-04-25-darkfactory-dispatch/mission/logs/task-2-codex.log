+        }
+
+        let (wait_tx, wait_rx) = watch::channel(None);
+        tokio::spawn(async move {
+            let result = child
+                .wait()
+                .await
+                .map(|status| ExitResult {
+                    code: status.code(),
+                    signal: status.signal(),
