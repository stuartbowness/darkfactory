+    let elapsed = started.elapsed();
+
+    assert_eq!(result.signal, Some(libc::SIGKILL));
+    assert!(elapsed >= Duration::from_secs(1));
+    assert!(elapsed < Duration::from_secs(3));
+
+    Ok(())
+}
