@@ -0,0 +1,265 @@
+#[path = "../src/engine.rs"]
+mod engine;
+#[path = "../src/event.rs"]
+mod event;
+#[expect(
+    dead_code,
+    reason = "integration tests exercise selected supervisor APIs indirectly"
+)]
