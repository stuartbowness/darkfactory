index 0000000000000000000000000000000000000000..812f23df9fb9b5a6858019ef7d2c7f388636b0df
--- /dev/null
+++ b/tools/darkfactory-dispatch/tests/engine.rs
@@ -0,0 +1,265 @@
+#[path = "../src/engine.rs"]
+mod engine;
+#[path = "../src/event.rs"]
+mod event;
+#[expect(
+    dead_code,
+    reason = "integration tests exercise selected supervisor APIs indirectly"
+)]
+#[path = "../src/supervisor.rs"]
+mod supervisor;
+#[path = "../src/types.rs"]
+mod types;
+
+use std::io::{self, Write};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, LazyLock, Mutex};
+
+use event::{Emitter, StreamMode};
+use nix::libc;
+use serde_json::Value;
+use tokio::sync::Mutex as AsyncMutex;
+use types::{DispatchSpec, DispatchStatus};
+
+static TEST_ID: AtomicU64 = AtomicU64::new(1);
+static PATH_LOCK: LazyLock<AsyncMutex<()>> = LazyLock::new(|| AsyncMutex::new(()));
+
+#[derive(Clone)]
+struct SharedBuffer {
+    inner: Arc<Mutex<Vec<u8>>>,
+}
+
+impl Write for SharedBuffer {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.inner
+            .lock()
+            .expect("shared buffer mutex poisoned")
+            .write(buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
