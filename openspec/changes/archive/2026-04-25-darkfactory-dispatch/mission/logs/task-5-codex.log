diff --git a/tools/darkfactory-dispatch/tests/engine.rs b/tools/darkfactory-dispatch/tests/engine.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9c8ec229e0cf488878427d32fd264d3ebaecccd7
--- /dev/null
+++ b/tools/darkfactory-dispatch/tests/engine.rs
@@ -0,0 +1,273 @@
+#[expect(
+    dead_code,
+    reason = "integration tests exercise selected event APIs directly"
+)]
+#[path = "../src/event.rs"]
+mod event;
+#[expect(
+    dead_code,
+    reason = "integration tests exercise selected supervisor APIs indirectly"
+)]
+#[path = "../src/supervisor.rs"]
+mod supervisor;
+#[expect(
+    dead_code,
+    reason = "integration tests exercise selected result fields directly"
+)]
+#[path = "../src/types.rs"]
+mod types;
+#[path = "../src/engine.rs"]
+mod engine;
+
+use std::io::{self, Write};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, LazyLock, Mutex};
+
+use event::{Emitter, StreamMode};
+use nix::libc;
+use serde_json::Value;
+use tokio::sync::Mutex as AsyncMutex;
+use types::{DispatchSpec, DispatchStatus};
+
+static TEST_ID: AtomicU64 = AtomicU64::new(1);
+static PATH_LOCK: LazyLock<AsyncMutex<()>> = LazyLock::new(|| AsyncMutex::new(()));
+
+#[derive(Clone)]
+struct SharedBuffer {
+    inner: Arc<Mutex<Vec<u8>>>,
+}
+
+impl Write for SharedBuffer {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.inner
+            .lock()
+            .expect("shared buffer mutex poisoned")
+            .write(buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn successful_dispatch_tracks_tokens_and_activity() -> Result<(), Box<dyn std::error::Error>>
+{
+    let _path_guard = TestPath::install("success").await?;
+    let tmp = temp_test_dir("success")?;
+    let output = tmp.join("result.md");
+    let log = tmp.join("codex.log");
+    let result = engine::dispatch(
+        spec(&tmp, &output, Some(log.clone()), 10, 0),
+        "dispatch-success".to_string(),
+        emitter("dispatch-success").0,
+    )
+    .await?;
+
+    assert_eq!(result.status, DispatchStatus::Completed);
+    assert_eq!(result.exit_code, Some(0));
+    assert!(result.output_exists);
+    assert_eq!(result.tokens.input, 100);
+    assert_eq!(result.tokens.output, 50);
+    assert_eq!(result.tokens.reasoning, 20);
+    assert_eq!(result.activity.tool_calls, 1);
+    assert_eq!(result.activity.commands_run, vec!["cargo test"]);
+    assert_eq!(result.activity.files_changed, vec!["src/main.rs"]);
+    assert_eq!(result.activity.files_read, vec!["README.md"]);
+
+    let log_text = std::fs::read_to_string(log)?;
+    assert!(log_text.contains("thread.started"));
+    assert!(log_text.contains("mock stderr line"));
+
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn timeout_dispatch_stops_child_process() -> Result<(), Box<dyn std::error::Error>> {
+    let _path_guard = TestPath::install("sleep").await?;
+    let tmp = temp_test_dir("timeout")?;
+    let output = tmp.join("result.md");
+    let pid_file = tmp.join("pid");
+    std::env::set_var("CODEX_MOCK_PID_FILE", &pid_file);
+
+    let result = engine::dispatch(
+        spec(&tmp, &output, None, 1, 1),
+        "dispatch-timeout".to_string(),
+        emitter("dispatch-timeout").0,
+    )
+    .await?;
+
+    std::env::remove_var("CODEX_MOCK_PID_FILE");
+    assert_eq!(result.status, DispatchStatus::TimedOut);
+    assert!(result.error.as_ref().is_some_and(|error| error.retryable));
+
+    let pid = std::fs::read_to_string(pid_file)?.trim().parse::<i32>()?;
+    assert_process_exits(pid).await?;
+
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn heartbeat_events_are_emitted_during_running_dispatch(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let _path_guard = TestPath::install("delayed_success").await?;
+    let tmp = temp_test_dir("heartbeat")?;
+    let output = tmp.join("result.md");
+    let (emitter, buffer) = emitter("dispatch-heartbeat");
+
+    let result = engine::dispatch(
+        spec(&tmp, &output, None, 10, 0),
+        "dispatch-heartbeat".to_string(),
+        emitter,
+    )
+    .await?;
+
+    assert_eq!(result.status, DispatchStatus::Completed);
+    let events = buffer_events(&buffer)?;
+    let heartbeats = events
+        .iter()
+        .filter(|event| event["type"] == "heartbeat")
+        .collect::<Vec<_>>();
+    assert!(heartbeats.len() >= 2, "events: {events:?}");
+    assert!(heartbeats
+        .iter()
+        .all(|event| event["interval_s"].as_u64() == Some(1)));
+
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn malformed_ndjson_is_counted_and_logged() -> Result<(), Box<dyn std::error::Error>> {
+    let _path_guard = TestPath::install("malformed").await?;
+    let tmp = temp_test_dir("malformed")?;
+    let output = tmp.join("result.md");
+    let log = tmp.join("codex.log");
+    let result = engine::dispatch(
+        spec(&tmp, &output, Some(log.clone()), 10, 0),
+        "dispatch-malformed".to_string(),
+        emitter("dispatch-malformed").0,
+    )
+    .await?;
+
+    assert_eq!(result.status, DispatchStatus::Completed);
+    assert_eq!(result.activity.parse_errors, 2);
+    let log_text = std::fs::read_to_string(log)?;
+    assert!(log_text.contains("not json"));
+    assert!(log_text.contains("{still not json"));
+
+    Ok(())
+}
+
+fn emitter(dispatch_id: &str) -> (Arc<Emitter>, Arc<Mutex<Vec<u8>>>) {
+    let buffer = Arc::new(Mutex::new(Vec::new()));
+    let emitter = Emitter::with_writer(
+        dispatch_id,
+        StreamMode::Verbose,
+        SharedBuffer {
+            inner: Arc::clone(&buffer),
+        },
+    );
+    (Arc::new(emitter), buffer)
+}
+
+fn buffer_events(buffer: &Arc<Mutex<Vec<u8>>>) -> Result<Vec<Value>, Box<dyn std::error::Error>> {
+    let bytes = buffer.lock().expect("shared buffer mutex poisoned").clone();
+    let text = String::from_utf8(bytes)?;
+    text.lines()
+        .map(|line| serde_json::from_str::<Value>(line).map_err(Into::into))
+        .collect()
+}
+
+fn spec(
+    cwd: &Path,
+    output: &Path,
+    log: Option<PathBuf>,
+    timeout_sec: u64,
+    grace_sec: u64,
+) -> DispatchSpec {
+    DispatchSpec {
+        model: "gpt-5".to_string(),
+        effort: Some("low".to_string()),
+        timeout_sec,
+        grace_sec,
+        sandbox: "workspace-write".to_string(),
+        configs: vec!["notify=false".to_string()],
+        prompt: "run the test task".to_string(),
+        output: Some(output.to_path_buf()),
+        cwd: cwd.to_path_buf(),
+        log,
+    }
+}
+
+fn temp_test_dir(name: &str) -> io::Result<PathBuf> {
+    let id = TEST_ID.fetch_add(1, Ordering::Relaxed);
+    let path = std::env::temp_dir().join(format!(
+        "darkfactory-dispatch-test-{}-{name}-{id}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&path)?;
+    Ok(path)
+}
+
+struct TestPath {
+    _guard: tokio::sync::MutexGuard<'static, ()>,
+    previous_path: Option<String>,
+    previous_mode: Option<String>,
+}
+
+impl TestPath {
+    async fn install(mode: &str) -> Result<Self, Box<dyn std::error::Error>> {
+        let guard = PATH_LOCK.lock().await;
+        let bin_dir = temp_test_dir("bin")?;
+        let source = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/test_codex_mock.sh");
+        let target = bin_dir.join("codex");
+        std::fs::copy(source, &target)?;
+
+        let previous_path = std::env::var("PATH").ok();
+        let previous_mode = std::env::var("CODEX_MOCK_MODE").ok();
+        let path = previous_path.clone().unwrap_or_default();
+        std::env::set_var("PATH", format!("{}:{path}", bin_dir.display()));
+        std::env::set_var("CODEX_MOCK_MODE", mode);
+
+        Ok(Self {
+            _guard: guard,
+            previous_path,
+            previous_mode,
+        })
+    }
+}
+
+impl Drop for TestPath {
+    fn drop(&mut self) {
+        match &self.previous_path {
+            Some(path) => std::env::set_var("PATH", path),
+            None => std::env::remove_var("PATH"),
+        }
+        match &self.previous_mode {
+            Some(mode) => std::env::set_var("CODEX_MOCK_MODE", mode),
+            None => std::env::remove_var("CODEX_MOCK_MODE"),
+        }
+        std::env::remove_var("CODEX_MOCK_PID_FILE");
+    }
+}
+
+async fn assert_process_exits(pid: i32) -> Result<(), Box<dyn std::error::Error>> {
+    for _ in 0..40 {
+        if !process_exists(pid) {
+            return Ok(());
+        }
+        tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+    }
+
+    Err(format!("process {pid} still exists").into())
+}
+
+fn process_exists(pid: i32) -> bool {
+    let rc = unsafe { libc::kill(pid, 0) };
+    if rc == 0 {
+        return true;
+    }
+
+    io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)
+}
diff --git a/tools/darkfactory-dispatch/tests/test_codex_mock.sh b/tools/darkfactory-dispatch/tests/test_codex_mock.sh
new file mode 100755
index 0000000000000000000000000000000000000000..fa5aaa466dc1297352bc4ce51d378d209bf174a2
--- /dev/null
+++ b/tools/darkfactory-dispatch/tests/test_codex_mock.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+output=""
+while (($#)); do
+  if [[ "$1" == "-o" && $# -ge 2 ]]; then
+    output="$2"
+    shift 2
+    continue
+  fi
+  shift
+done
+
+mode="${CODEX_MOCK_MODE:-success}"
+if [[ -n "${CODEX_MOCK_PID_FILE:-}" ]]; then
+  echo "$$" > "${CODEX_MOCK_PID_FILE}"
+fi
+
+write_output() {
+  if [[ -n "$output" ]]; then
+    mkdir -p "$(dirname "$output")"
+    echo "mock output" > "$output"
+  fi
+}
+
+case "$mode" in
+  success)
+    echo '{"type":"thread.started","thread_id":"test-123"}'
+    echo '{"type":"item.started","item":{"type":"tool_use","name":"shell"}}'
+    echo '{"type":"item.started","item":{"type":"function_call","command":"cargo test"}}'
+    echo '{"type":"item.completed","item":{"type":"function_call","command":"cargo test"}}'
+    echo '{"type":"item.completed","item":{"type":"file_change","file_path":"src/main.rs"}}'
+    echo '{"type":"item.completed","item":{"type":"file_read","file_path":"README.md"}}'
+    echo '{"type":"item.completed","item":{"type":"tool_use","name":"shell"}}'
+    echo '{"type":"turn.completed","usage":{"input_tokens":100,"output_tokens":50,"reasoning_tokens":20}}'
+    echo "mock stderr line" >&2
+    write_output
+    ;;
+  malformed)
+    echo 'not json'
+    echo '{"type":"turn.completed","usage":{"input_tokens":1,"output_tokens":2,"reasoning_tokens":3}}'
+    echo '{still not json'
+    write_output
+    ;;
+  sleep)
+    sleep 300
+    ;;
+  delayed_success)
+    echo '{"type":"thread.started","thread_id":"slow-123"}'
+    sleep 3
+    echo '{"type":"turn.completed","usage":{"input_tokens":4,"output_tokens":5,"reasoning_tokens":6}}'
+    write_output
+    ;;
+  *)
+    echo "unknown CODEX_MOCK_MODE: $mode" >&2
+    exit 64
+    ;;
+esac

diff --git a/tools/darkfactory-dispatch/src/engine.rs b/tools/darkfactory-dispatch/src/engine.rs
index 1039d4c5076f11e83a2db0d509ec61e8e6757eab..9ad5cc03ab8a98c65ece69abacb2ddf68e9fcc8d
--- a/tools/darkfactory-dispatch/src/engine.rs
+++ b/tools/darkfactory-dispatch/src/engine.rs
@@ -1 +1,745 @@
-// TODO: implement
+use std::ffi::OsString;
+use std::io::{self, Write};
+use std::path::{Path, PathBuf};
+use std::pin::Pin;
+use std::sync::Arc;
+use std::time::Instant as StdInstant;
+
+use chrono::{SecondsFormat, Utc};
+use serde_json::Value;
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::sync::Mutex;
+use tokio::time::{self, Duration, Instant, Sleep};
+
+use crate::event::Emitter;
+use crate::supervisor::{ExitResult, StdinMode, SupervisorBuilder, SupervisorError};
+use crate::types::{
+    Activity, DispatchError, DispatchErrorInfo, DispatchResult, DispatchSpec, DispatchStatus,
+    EventKind, HarnessEvent, LiveStatus, TokenUsage,
+};
+
+const STDOUT_BUFFER_BYTES: usize = 4 * 1024 * 1024;
+const WATCHDOG_INTERVAL_SECS: u64 = 5;
+
+#[cfg(test)]
+const HEARTBEAT_INTERVAL_SECS: u64 = 1;
+#[cfg(not(test))]
+const HEARTBEAT_INTERVAL_SECS: u64 = 15;
+
+pub(crate) async fn dispatch(
+    spec: DispatchSpec,
+    dispatch_id: String,
+    emitter: Arc<Emitter>,
+) -> Result<DispatchResult, DispatchError> {
+    let started = StdInstant::now();
+    let grace_sec = effective_grace_sec(spec.timeout_sec, spec.grace_sec);
+
+    emitter
+        .emit_dispatch_start("codex", spec.model.clone())
+        .map_err(dispatch_event_error)?;
+
+    let args = build_codex_args(&spec);
+    let run_handle = SupervisorBuilder::new("codex")
+        .args(args)
+        .current_dir(&spec.cwd)
+        .stdin(StdinMode::Null)
+        .spawn()
+        .map_err(map_supervisor_error)?;
+
+    let stdout = run_handle.stdout().map_err(map_supervisor_error)?;
+    let stderr = run_handle.stderr().map_err(map_supervisor_error)?;
+    let log = open_log(spec.log.as_deref()).await?;
+    let stderr_task = tokio::spawn(capture_stderr(stderr, log.clone()));
+
+    let mut stdout_reader = BufReader::with_capacity(STDOUT_BUFFER_BYTES, stdout).lines();
+    let mut tracker = ActivityTracker::new();
+    let output_path = spec.output.clone();
+    let status_dir = status_dir(&dispatch_id);
+
+    let soft_sleep = time::sleep(Duration::from_secs(spec.timeout_sec));
+    tokio::pin!(soft_sleep);
+    let mut soft_armed = true;
+    let mut hard_sleep: Option<Pin<Box<Sleep>>> = None;
+    let mut watchdog_interval = time::interval_at(
+        Instant::now() + Duration::from_secs(WATCHDOG_INTERVAL_SECS),
+        Duration::from_secs(WATCHDOG_INTERVAL_SECS),
+    );
+    let mut heartbeat_interval = time::interval_at(
+        Instant::now() + Duration::from_secs(HEARTBEAT_INTERVAL_SECS),
+        Duration::from_secs(HEARTBEAT_INTERVAL_SECS),
+    );
+
+    let (exit, timed_out) = loop {
+        tokio::select! {
+            line = stdout_reader.next_line() => {
+                match line {
+                    Ok(Some(line)) => {
+                        write_log_line(&log, &line).await?;
+                        if let Some(event) = parse_codex_event(&line) {
+                            tracker.apply(event, &emitter)?;
+                        }
+                    }
+                    Ok(None) => {
+                        soft_armed = false;
+                    }
+                    Err(error) => return Err(DispatchError::Other(format!("read child stdout: {error}"))),
+                }
+            }
+
+            result = run_handle.wait() => {
+                break (result.map_err(map_supervisor_error)?, false);
+            }
+
+            () = &mut soft_sleep, if soft_armed => {
+                soft_armed = false;
+                tracker.last_activity = format!("soft timeout after {}s", spec.timeout_sec);
+                emitter.emit_timeout_warning().map_err(dispatch_event_error)?;
+                hard_sleep = Some(Box::pin(time::sleep(Duration::from_secs(grace_sec))));
+            }
+
+            () = async {
+                if let Some(timer) = hard_sleep.as_mut() {
+                    timer.as_mut().await;
+                } else {
+                    std::future::pending::<()>().await;
+                }
+            }, if hard_sleep.is_some() => {
+                tracker.last_activity = format!("hard timeout after {}s grace", grace_sec);
+                let exit = run_handle
+                    .graceful_stop(grace_sec.max(10))
+                    .await
+                    .map_err(map_supervisor_error)?;
+                break (exit, true);
+            }
+
+            _ = watchdog_interval.tick() => {
+                let _ = write_status_json_atomic(
+                    &status_dir,
+                    &dispatch_id,
+                    started.elapsed().as_secs(),
+                    &tracker,
+                );
+            }
+
+            _ = heartbeat_interval.tick() => {
+                emitter
+                    .emit_heartbeat_with_interval(
+                        tracker.last_activity.clone(),
+                        HEARTBEAT_INTERVAL_SECS,
+                    )
+                    .map_err(dispatch_event_error)?;
+            }
+        }
+    };
+
+    let stderr = stderr_task
+        .await
+        .map_err(|error| DispatchError::Other(format!("stderr capture task failed: {error}")))??;
+
+    let result = finalize_result(
+        dispatch_id,
+        started.elapsed().as_millis() as u64,
+        exit,
+        timed_out,
+        output_path.as_deref(),
+        tracker,
+        stderr,
+    );
+    emitter
+        .emit_dispatch_end(status_name(&result.status), result.duration_ms)
+        .map_err(dispatch_event_error)?;
+
+    Ok(result)
+}
+
+fn build_codex_args(spec: &DispatchSpec) -> Vec<OsString> {
+    let sandbox = if spec.sandbox.is_empty() {
+        "workspace-write"
+    } else {
+        spec.sandbox.as_str()
+    };
+    let mut args = vec![
+        "exec".into(),
+        "--json".into(),
+        "--full-auto".into(),
+        "-s".into(),
+        sandbox.into(),
+        "-m".into(),
+        spec.model.clone().into(),
+    ];
+
+    if let Some(effort) = spec.effort.as_deref().filter(|effort| !effort.is_empty()) {
+        args.push("-c".into());
+        args.push(format!("model_reasoning_effort=\"{effort}\"").into());
+    }
+    for config in &spec.configs {
+        args.push("-c".into());
+        args.push(config.clone().into());
+    }
+    if let Some(output) = &spec.output {
+        args.push("-o".into());
+        args.push(output.as_os_str().to_os_string());
+    }
+    args.push(spec.prompt.clone().into());
+
+    args
+}
+
+type SharedLog = Option<Arc<Mutex<tokio::fs::File>>>;
+
+async fn open_log(path: Option<&Path>) -> Result<SharedLog, DispatchError> {
+    let Some(path) = path else {
+        return Ok(None);
+    };
+    if let Some(parent) = path.parent() {
+        tokio::fs::create_dir_all(parent).await.map_err(DispatchError::SpawnFailed)?;
+    }
+    let file = tokio::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .await
+        .map_err(DispatchError::SpawnFailed)?;
+    Ok(Some(Arc::new(Mutex::new(file))))
+}
+
+async fn capture_stderr(
+    stderr: tokio::process::ChildStderr,
+    log: SharedLog,
+) -> Result<String, DispatchError> {
+    let mut reader = BufReader::new(stderr);
+    let mut captured = String::new();
+    loop {
+        let mut line = String::new();
+        let bytes = reader
+            .read_line(&mut line)
+            .await
+            .map_err(|error| DispatchError::Other(format!("read child stderr: {error}")))?;
+        if bytes == 0 {
+            break;
+        }
+        if let Some(file) = &log {
+            let mut file = file.lock().await;
+            file.write_all(line.as_bytes())
+                .await
+                .map_err(DispatchError::SpawnFailed)?;
+            file.flush().await.map_err(DispatchError::SpawnFailed)?;
+        }
+        captured.push_str(&line);
+    }
+    Ok(captured)
+}
+
+async fn write_log_line(log: &SharedLog, line: &str) -> Result<(), DispatchError> {
+    if let Some(file) = log {
+        let mut file = file.lock().await;
+        file.write_all(line.as_bytes())
+            .await
+            .map_err(DispatchError::SpawnFailed)?;
+        file.write_all(b"\n")
+            .await
+            .map_err(DispatchError::SpawnFailed)?;
+        file.flush().await.map_err(DispatchError::SpawnFailed)?;
+    }
+    Ok(())
+}
+
+fn parse_codex_event(line: &str) -> Option<HarnessEvent> {
+    let line = line.trim();
+    if line.is_empty() {
+        return None;
+    }
+
+    let Ok(raw) = serde_json::from_str::<Value>(line) else {
+        return Some(event(EventKind::RawPassthrough).text(line));
+    };
+
+    let event_type = raw.get("type").and_then(Value::as_str).unwrap_or_default();
+    match event_type {
+        "thread.started" => Some(event(EventKind::SessionStart).session_id(string_field(
+            &raw,
+            &["thread_id", "session_id"],
+        ))),
+        "turn.started" | "item.updated" => None,
+        "item.started" => parse_item_started(&raw),
+        "item.completed" => parse_item_completed(&raw),
+        "turn.completed" => Some(event(EventKind::TurnComplete).tokens(TokenUsage {
+            input: number_path(&raw, &[&["usage", "input_tokens"], &["input_tokens"]]),
+            output: number_path(&raw, &[&["usage", "output_tokens"], &["output_tokens"]]),
+            reasoning: number_path(
+                &raw,
+                &[&["usage", "reasoning_tokens"], &["reasoning_tokens"]],
+            ),
+        })),
+        "turn.failed" => Some(event(EventKind::TurnFailed).text(
+            string_path(
+                &raw,
+                &[&["error", "message"], &["message"], &["error"]],
+            )
+            .unwrap_or_else(|| "turn failed".to_string()),
+        )),
+        "error" => Some(event(EventKind::Error).text(
+            string_path(&raw, &[&["message"], &["error", "message"]])
+                .unwrap_or_else(|| "codex error".to_string()),
+        )),
+        _ => Some(event(EventKind::RawPassthrough).text(line)),
+    }
+}
+
+fn parse_item_started(raw: &Value) -> Option<HarnessEvent> {
+    let item_type = item_string(raw, "type").unwrap_or_default();
+    match item_type.as_str() {
+        "agent_message" => None,
+        "function_call" | "command_execution" => {
+            let command = item_string(raw, "command")
+                .or_else(|| string_path(raw, &[&["item", "input", "command"], &["command"]]));
+            Some(event(EventKind::CommandRun).command(command))
+        }
+        _ => {
+            let tool = item_string(raw, "name").unwrap_or(item_type);
+            Some(event(EventKind::ToolStart).tool(Some(tool)))
+        }
+    }
+}
+
+fn parse_item_completed(raw: &Value) -> Option<HarnessEvent> {
+    let item_type = item_string(raw, "type").unwrap_or_default();
+    let file = file_path(raw);
+    if is_file_read(&item_type, raw) {
+        return Some(event(EventKind::FileRead).file(file));
+    }
+    if is_file_write(&item_type, raw) {
+        return Some(event(EventKind::FileWrite).file(file));
+    }
+
+    match item_type.as_str() {
+        "agent_message" => Some(event(EventKind::Response).text(
+            item_string(raw, "text")
+                .or_else(|| string_field(raw, &["content", "text", "message"]))
+                .unwrap_or_default(),
+        )),
+        "function_call" | "command_execution" => Some(
+            event(EventKind::ToolEnd)
+                .tool(Some(item_type))
+                .command(item_string(raw, "command").or_else(|| string_field(raw, &["command"]))),
+        ),
+        "" => Some(event(EventKind::RawPassthrough).text(raw.to_string())),
+        _ => {
+            let tool = item_string(raw, "name").unwrap_or(item_type);
+            Some(event(EventKind::ToolEnd).tool(Some(tool)))
+        }
+    }
+}
+
+fn is_file_read(item_type: &str, raw: &Value) -> bool {
+    matches!(item_type, "file_read" | "read_file")
+        || matches!(
+            item_string(raw, "name").as_deref(),
+            Some("read_file" | "Read")
+        )
+}
+
+fn is_file_write(item_type: &str, raw: &Value) -> bool {
+    matches!(item_type, "file_change" | "file_write" | "write_file")
+        || raw
+            .get("change_type")
+            .and_then(Value::as_str)
+            .is_some_and(|change| !change.is_empty())
+        || matches!(
+            item_string(raw, "name").as_deref(),
+            Some("write_file" | "Edit" | "Write")
+        )
+}
+
+fn file_path(raw: &Value) -> Option<String> {
+    string_path(
+        raw,
+        &[
+            &["file_path"],
+            &["path"],
+            &["item", "file_path"],
+            &["item", "path"],
+            &["item", "input", "file_path"],
+            &["item", "input", "path"],
+            &["item", "parameters", "file_path"],
+            &["item", "parameters", "path"],
+        ],
+    )
+}
+
+fn item_string(raw: &Value, key: &str) -> Option<String> {
+    raw.get("item")
+        .and_then(|item| item.get(key))
+        .and_then(Value::as_str)
+        .or_else(|| raw.get(key).and_then(Value::as_str))
+        .map(str::to_string)
+}
+
+fn string_field(raw: &Value, keys: &[&str]) -> Option<String> {
+    keys.iter()
+        .find_map(|key| raw.get(*key).and_then(Value::as_str))
+        .map(str::to_string)
+}
+
+fn string_path(raw: &Value, paths: &[&[&str]]) -> Option<String> {
+    paths
+        .iter()
+        .find_map(|path| {
+            path.iter()
+                .try_fold(raw, |value, key| value.get(*key))
+                .and_then(Value::as_str)
+        })
+        .map(str::to_string)
+}
+
+fn number_path(raw: &Value, paths: &[&[&str]]) -> u64 {
+    paths
+        .iter()
+        .find_map(|path| {
+            path.iter()
+                .try_fold(raw, |value, key| value.get(*key))
+                .and_then(Value::as_u64)
+        })
+        .unwrap_or(0)
+}
+
+fn event(kind: EventKind) -> HarnessEvent {
+    HarnessEvent {
+        kind,
+        tool: None,
+        file: None,
+        command: None,
+        text: None,
+        tokens: None,
+        session_id: None,
+    }
+}
+
+trait EventBuilder {
+    fn tool(self, tool: Option<String>) -> Self;
+    fn file(self, file: Option<String>) -> Self;
+    fn command(self, command: Option<String>) -> Self;
+    fn text(self, text: impl Into<String>) -> Self;
+    fn tokens(self, tokens: TokenUsage) -> Self;
+    fn session_id(self, session_id: Option<String>) -> Self;
+}
+
+impl EventBuilder for HarnessEvent {
+    fn tool(mut self, tool: Option<String>) -> Self {
+        self.tool = tool;
+        self
+    }
+
+    fn file(mut self, file: Option<String>) -> Self {
+        self.file = file;
+        self
+    }
+
+    fn command(mut self, command: Option<String>) -> Self {
+        self.command = command;
+        self
+    }
+
+    fn text(mut self, text: impl Into<String>) -> Self {
+        self.text = Some(text.into());
+        self
+    }
+
+    fn tokens(mut self, tokens: TokenUsage) -> Self {
+        self.tokens = Some(tokens);
+        self
+    }
+
+    fn session_id(mut self, session_id: Option<String>) -> Self {
+        self.session_id = session_id;
+        self
+    }
+}
+
+struct ActivityTracker {
+    activity: Activity,
+    tokens: TokenUsage,
+    last_activity: String,
+}
+
+impl ActivityTracker {
+    fn new() -> Self {
+        Self {
+            activity: Activity::default(),
+            tokens: TokenUsage::default(),
+            last_activity: "dispatch started".to_string(),
+        }
+    }
+
+    fn apply(&mut self, event: HarnessEvent, emitter: &Emitter) -> Result<(), DispatchError> {
+        match event.kind {
+            EventKind::SessionStart => {
+                self.last_activity = format!(
+                    "session started: {}",
+                    event.session_id.unwrap_or_else(|| "unknown".to_string())
+                );
+            }
+            EventKind::ToolStart => {
+                let tool = event.tool.unwrap_or_else(|| "tool".to_string());
+                self.activity.tool_calls += 1;
+                self.last_activity = format!("tool started: {tool}");
+                emitter.emit_tool_start(tool).map_err(dispatch_event_error)?;
+            }
+            EventKind::ToolEnd => {
+                let tool = event.tool.unwrap_or_else(|| "tool".to_string());
+                self.last_activity = format!("tool ended: {tool}");
+                emitter.emit_tool_end(tool).map_err(dispatch_event_error)?;
+            }
+            EventKind::FileWrite => {
+                if let Some(path) = event.file {
+                    push_unique(&mut self.activity.files_changed, path.clone());
+                    self.last_activity = format!("file changed: {path}");
+                    emitter.emit_file_write(path).map_err(dispatch_event_error)?;
+                }
+            }
+            EventKind::FileRead => {
+                if let Some(path) = event.file {
+                    push_unique(&mut self.activity.files_read, path.clone());
+                    self.last_activity = format!("file read: {path}");
+                    emitter.emit_file_read(path).map_err(dispatch_event_error)?;
+                }
+            }
+            EventKind::CommandRun => {
+                if let Some(command) = event.command {
+                    self.activity.commands_run.push(command.clone());
+                    self.last_activity = format!("command: {command}");
+                    emitter
+                        .emit_command_run(command)
+                        .map_err(dispatch_event_error)?;
+                }
+            }
+            EventKind::Response => {
+                self.last_activity = "agent response".to_string();
+            }
+            EventKind::TurnComplete => {
+                if let Some(tokens) = event.tokens {
+                    self.tokens.input += tokens.input;
+                    self.tokens.output += tokens.output;
+                    self.tokens.reasoning += tokens.reasoning;
+                    self.last_activity = "turn completed".to_string();
+                }
+            }
+            EventKind::TurnFailed => {
+                let message = event.text.unwrap_or_else(|| "turn failed".to_string());
+                self.last_activity = format!("turn failed: {message}");
+                emitter
+                    .emit_error("turn_failed", message)
+                    .map_err(dispatch_event_error)?;
+            }
+            EventKind::Error => {
+                let message = event.text.unwrap_or_else(|| "codex error".to_string());
+                self.last_activity = format!("error: {message}");
+                emitter
+                    .emit_error("codex_error", message)
+                    .map_err(dispatch_event_error)?;
+            }
+            EventKind::RawPassthrough => {
+                self.activity.parse_errors += 1;
+                self.last_activity = "raw passthrough".to_string();
+            }
+        }
+
+        Ok(())
+    }
+}
+
+fn push_unique(values: &mut Vec<String>, value: String) {
+    if !values.iter().any(|existing| existing == &value) {
+        values.push(value);
+    }
+}
+
+fn finalize_result(
+    dispatch_id: String,
+    duration_ms: u64,
+    exit: ExitResult,
+    timed_out: bool,
+    output: Option<&Path>,
+    tracker: ActivityTracker,
+    stderr: String,
+) -> DispatchResult {
+    let output_exists = output.is_some_and(Path::exists);
+    let status = if timed_out {
+        DispatchStatus::TimedOut
+    } else if exit.code == Some(0) && output_exists {
+        DispatchStatus::Completed
+    } else {
+        DispatchStatus::Failed
+    };
+
+    let error = match status {
+        DispatchStatus::Completed => None,
+        DispatchStatus::TimedOut => Some(DispatchErrorInfo {
+            code: "timed_out".to_string(),
+            message: "dispatch timed out".to_string(),
+            retryable: true,
+        }),
+        DispatchStatus::Failed => Some(DispatchErrorInfo {
+            code: if exit.code == Some(0) && !output_exists {
+                "missing_output"
+            } else {
+                "process_failed"
+            }
+            .to_string(),
+            message: failure_message(exit, output_exists, &stderr),
+            retryable: true,
+        }),
+    };
+
+    DispatchResult {
+        status,
+        dispatch_id,
+        duration_ms,
+        exit_code: exit.code,
+        signal: exit.signal,
+        output: output.map(|path| path.display().to_string()),
+        output_exists,
+        error,
+        tokens: tracker.tokens,
+        activity: tracker.activity,
+    }
+}
+
+fn failure_message(exit: ExitResult, output_exists: bool, stderr: &str) -> String {
+    if exit.code == Some(0) && !output_exists {
+        return "child exited successfully but output file was not created".to_string();
+    }
+    let stderr = stderr.trim();
+    if stderr.is_empty() {
+        format!(
+            "child process failed: exit code {:?}, signal {:?}",
+            exit.code, exit.signal
+        )
+    } else {
+        format!(
+            "child process failed: exit code {:?}, signal {:?}: {}",
+            exit.code, exit.signal, stderr
+        )
+    }
+}
+
+fn write_status_json_atomic(
+    dir: &Path,
+    dispatch_id: &str,
+    elapsed_s: u64,
+    tracker: &ActivityTracker,
+) -> io::Result<()> {
+    std::fs::create_dir_all(dir)?;
+    let status = LiveStatus {
+        state: "running".to_string(),
+        elapsed_s,
+        last_activity: tracker.last_activity.clone(),
+        tools_used: tracker.activity.tool_calls,
+        files_changed: tracker.activity.files_changed.len() as u64,
+        dispatch_id: dispatch_id.to_string(),
+        ts: Utc::now().to_rfc3339_opts(SecondsFormat::Secs, true),
+    };
+    let final_path = dir.join("status.json");
+    let tmp_path = dir.join(format!("status.json.tmp.{}", std::process::id()));
+    {
+        let mut file = std::fs::File::create(&tmp_path)?;
+        serde_json::to_writer(&mut file, &status)?;
+        file.write_all(b"\n")?;
+        file.sync_all()?;
+    }
+    std::fs::rename(&tmp_path, final_path)?;
+    if let Ok(dir_file) = std::fs::File::open(dir) {
+        let _ = dir_file.sync_all();
+    }
+    Ok(())
+}
+
+fn status_dir(dispatch_id: &str) -> PathBuf {
+    std::env::temp_dir()
+        .join("darkfactory-dispatch")
+        .join(dispatch_id)
+}
+
+fn effective_grace_sec(timeout_sec: u64, grace_sec: u64) -> u64 {
+    if grace_sec == 0 {
+        (timeout_sec / 2).max(1)
+    } else {
+        grace_sec
+    }
+}
+
+fn status_name(status: &DispatchStatus) -> &'static str {
+    match status {
+        DispatchStatus::Completed => "completed",
+        DispatchStatus::TimedOut => "timed_out",
+        DispatchStatus::Failed => "failed",
+    }
+}
+
+fn map_supervisor_error(error: SupervisorError) -> DispatchError {
+    match error {
+        SupervisorError::Spawn { program, message }
+            if program == "codex" && message.contains("No such file") =>
+        {
+            DispatchError::BinaryNotFound
+        }
+        other => DispatchError::Other(other.to_string()),
+    }
+}
+
+fn dispatch_event_error(error: impl std::fmt::Display) -> DispatchError {
+    DispatchError::Other(format!("emit dispatch event: {error}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn codex_args_include_expected_flags() {
+        let spec = DispatchSpec {
+            model: "gpt-5".to_string(),
+            effort: Some("high".to_string()),
+            timeout_sec: 10,
+            grace_sec: 0,
+            sandbox: String::new(),
+            configs: vec!["foo=bar".to_string()],
+            prompt: "do work".to_string(),
+            output: Some(PathBuf::from("out.txt")),
+            cwd: PathBuf::from("."),
+            log: None,
+        };
+
+        let args = build_codex_args(&spec)
+            .into_iter()
+            .map(|arg| arg.to_string_lossy().to_string())
+            .collect::<Vec<_>>();
+
+        assert_eq!(
+            args,
+            vec![
+                "exec",
+                "--json",
+                "--full-auto",
+                "-s",
+                "workspace-write",
+                "-m",
+                "gpt-5",
+                "-c",
+                "model_reasoning_effort=\"high\"",
+                "-c",
+                "foo=bar",
+                "-o",
+                "out.txt",
+                "do work",
+            ]
+        );
+    }
+
+    #[test]
+    fn malformed_json_is_raw_passthrough() {
+        let event = parse_codex_event("not json").expect("event");
+        assert_eq!(event.kind, EventKind::RawPassthrough);
+        assert_eq!(event.text.as_deref(), Some("not json"));
+    }
+}
