+    let mut stdout_reader = BufReader::with_capacity(STDOUT_BUFFER_BYTES, stdout).lines();
+    let mut tracker = ActivityTracker::new();
+    let output_path = spec.output.clone();
+    let status_dir = status_dir(&dispatch_id);
