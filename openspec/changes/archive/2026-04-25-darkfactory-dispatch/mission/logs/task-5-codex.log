+    }
+    for config in &spec.configs {
+        args.push("-c".into());
+        args.push(config.clone().into());
+    }
+    if let Some(output) = &spec.output {
+        args.push("-o".into());
+        args.push(output.as_os_str().to_os_string());
+    }
+    args.push(spec.prompt.clone().into());
+
+    args
