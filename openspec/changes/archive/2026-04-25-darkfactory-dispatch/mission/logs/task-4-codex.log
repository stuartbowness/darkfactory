+        self.emit(DispatchEvent {
+            event_type: "dispatch_start".to_string(),
+            engine: Some(engine.into()),
+            model: Some(model.into()),
+            ..self.base_event()
+        })
+    }
+
+    pub(crate) fn emit_dispatch_end(
