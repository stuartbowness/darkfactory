+#[derive(Debug, Error)]
+pub(crate) enum EventError {
+    #[error("serialize dispatch event: {0}")]
+    Serialize(#[from] serde_json::Error),
+    #[error("write dispatch event: {0}")]
+    Write(#[from] io::Error),
+}
