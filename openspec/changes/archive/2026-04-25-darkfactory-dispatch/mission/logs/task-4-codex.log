+            elapsed_s: None,
+            last_activity: None,
+            interval_s: None,
+            engine: None,
+            model: None,
+            tool: None,
+            file: None,
+            command: None,
+            status: None,
+            duration_ms: None,
+            code: None,
+            message: None,
+        }
+    }
+
+    fn elapsed_s(&self) -> u64 {
+        self.start.elapsed().as_secs()
+    }
