+            elapsed_s: Some(self.elapsed_s()),
+            last_activity: Some(last_activity.into()),
+            interval_s: Some(interval_s),
+            ..self.base_event()
+        })
+    }
+
+    fn emit(&self, event: DispatchEvent) -> Result<(), EventError> {
+        if !self.should_emit(&event.event_type) {
+            return Ok(());
+        }
