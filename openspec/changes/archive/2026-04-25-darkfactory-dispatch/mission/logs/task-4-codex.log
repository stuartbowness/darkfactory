+            tool: Some(tool.into()),
+            ..self.base_event()
+        })
+    }
+
+    pub(crate) fn emit_file_write(&self, path: impl Into<String>) -> Result<(), EventError> {
+        self.emit(DispatchEvent {
+            event_type: "file_write".to_string(),
+            file: Some(path.into()),
+            ..self.base_event()
+        })
+    }
+
+    pub(crate) fn emit_file_read(&self, path: impl Into<String>) -> Result<(), EventError> {
+        self.emit(DispatchEvent {
