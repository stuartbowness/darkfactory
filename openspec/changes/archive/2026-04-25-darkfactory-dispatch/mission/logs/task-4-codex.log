+pub(crate) struct Emitter {
+    dispatch_id: String,
+    start: Instant,
+    stream_mode: StreamMode,
+    writer: Arc<Mutex<Box<dyn Write + Send>>>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum StreamMode {
+    Silent,
+    Normal,
+    Verbose,
+}
