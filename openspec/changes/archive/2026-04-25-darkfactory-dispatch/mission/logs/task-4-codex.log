+impl Emitter {
+    pub(crate) fn new(dispatch_id: impl Into<String>, stream_mode: StreamMode) -> Self {
+        Self::with_writer(dispatch_id, stream_mode, io::stderr())
+    }
+
+    fn with_writer(
+        dispatch_id: impl Into<String>,
+        stream_mode: StreamMode,
