+        let mut line = serde_json::to_vec(&event)?;
+        line.push(b'\n');
+
+        let mut writer = self.writer.lock().expect("event writer mutex poisoned");
+        writer.write_all(&line)?;
+        writer.flush()?;
+
+        Ok(())
+    }
