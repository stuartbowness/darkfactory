+            .collect::<Vec<_>>();
+
+        assert_eq!(
+            event_types,
+            vec![
+                "dispatch_start",
+                "dispatch_end",
+                "heartbeat",
+                "timeout_warning",
+                "tool_start",
+                "tool_end",
