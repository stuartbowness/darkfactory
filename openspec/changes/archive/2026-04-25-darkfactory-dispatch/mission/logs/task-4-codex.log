+            StreamMode::Silent => matches!(
+                event_type,
+                "dispatch_start" | "dispatch_end" | "timeout_warning" | "error"
+            ),
+            StreamMode::Normal | StreamMode::Verbose => true,
+        }
+    }
+
+    fn base_event(&self) -> DispatchEvent {
