+        heartbeat_ticker(
+            Arc::new(emitter),
+            3600,
+            Arc::clone(&last_activity),
+            cancel.clone(),
+        );
+        cancel.cancel();
+        cancel.cancelled().await;
+
+        let _stderr_emitter = Emitter::new("dispatch-456", StreamMode::Verbose);
+    }
+}
