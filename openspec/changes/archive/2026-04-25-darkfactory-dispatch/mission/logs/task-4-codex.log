+            event_type: String::new(),
+            dispatch_id: self.dispatch_id.clone(),
+            ts: Utc::now().to_rfc3339_opts(SecondsFormat::Secs, true),
+            elapsed_s: None,
+            last_activity: None,
+            interval_s: None,
+            engine: None,
+            model: None,
+            tool: None,
+            file: None,
+            command: None,
+            status: None,
+            duration_ms: None,
+            code: None,
+            message: None,
+        }
+    }
+
+    fn elapsed_s(&self) -> u64 {
+        self.start.elapsed().as_secs()
+    }
+}
