ationale\": \"Catches promises used where a boolean, void callback, or plain value was expected.\"\n    },\n    {\n      \"name\": \"typescript/switch-exhaustiveness-check\",\n      \"category\": \"code-quality\",\n      \"severity\": \"error\",\n      \"default_enabled\": false,\n      \"rationale\": \"Forces every union case to be handled when switch statements evolve.\"\n    },\n    {\n      \"name\": \"eslint/no-empty\",\n      \"category\": \"error-handling\",\n      \"severity\": \"error\",\n      \"default_enabled\": false,\n      \"rationale\": \"Prevents empty blocks and catch handlers from hiding unfinished error handling.\"\n    },\n    {\n      \"name\": \"eslint/no-unused-vars\",\n      \"category\": \"code-quality\",\n      \"severity\": \"error\",\n      \"default_enabled\": true,\n      \"rationale\": \"Catches dead declarations left behind by incomplete edits.\"\n    },\n    {\n      \"name\": \"eslint/no-unused-expressions\",\n      \"category\": \"code-quality\",\n      \"severity\": \"error\",\n      \"default_enabled\": true,\n      \"rationale\": \"Flags expressions that do nothing and often indicate a mistaken edit.\"\n    },\n    {\n      \"name\": \"eslint/no-constant-condition\",\n      \"category\": \"code-quality\",\n      \"severity\": \"error\",\n      \"default_enabled\": true,\n      \"rationale\": \"Catches always-true or always-false branches that hide logic mistakes.\"\n    },\n    {\n      \"name\": \"import/no-cycle\",\n      \"category\": \"imports\",\n      \"severity\": \"error\",\n      \"default_enabled\": false,\n      \"rationale\": \"Prevents circular imports that can produce undefined values at runtime.\"\n    },\n    {\n      \"name\": \"import/named\",\n      \"category\": \"imports\",\n      \"severity\": \"error\",\n      \"default_enabled\": false,\n      \"rationale\": \"Catches imports and re-exports that reference names a module does not provide.\"\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
