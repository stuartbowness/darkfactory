{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba skills/lint-audit/tests/validate-rules-json.sh | sed -n '1,120p'\"","aggregated_output":"     1\t#!/bin/sh\n     2\tset -eu\n     3\t\n     4\trules_file=\"${1:-skills/lint-audit/rules.json}\"\n     5\t\n     6\tif ! command -v jq >/dev/null 2>&1; then\n     7\t  printf '%s\\n' \"jq is required to validate ${rules_file}\" >&2\n     8\t  exit 1\n     9\tfi\n    10\t\n    11\tjq -e '\n    12\t  def semver: test(\"^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\");\n    13\t  def canonical_rule_name: test(\"^[a-z0-9-]+/[a-z0-9-]+$\");\n    14\t  def allowed_category: IN(\"type-safety\", \"error-handling\", \"code-quality\", \"imports\");\n    15\t  def required_rules: [\n    16\t    \"typescript/no-explicit-any\",\n    17\t    \"typescript/no-non-null-assertion\",\n    18\t    \"typescript/no-floating-promises\",\n    19\t    \"typescript/no-misused-promises\",\n    20\t    \"typescript/switch-exhaustiveness-check\"\n    21\t  ];\n    22\t\n    23\t  (.oxlint_version | type == \"string\" and semver)\n    24\t  and (.rules | type == \"array\" and length >= 8)\n    25\t  and (\n    26\t    .rules\n    27\t    | all(\n    28\t      (.name | type == \"string\" and canonical_rule_name)\n    29\t      and (.category | type == \"string\" and allowed_category)\n    30\t      and (.severity | IN(\"error\", \"warn\"))\n    31\t      and (.default_enabled | type == \"boolean\")\n    32\t      and (.rationale | type == \"string\" and length > 0)\n    33\t    )\n    34\t  )\n    35\t  and ((.rules | map(.name) | length) == (.rules | map(.name) | unique | length))\n    36\t  and (\n    37\t    required_rules as $required\n    38\t    | (.rules | map(.name)) as $actual\n    39\t    | all($required[]; . as $rule | $actual | index($rule))\n    40\t  )\n    41\t' \"$rules_file\" >/dev/null\n","exit_code":0,"status":"completed"}}
