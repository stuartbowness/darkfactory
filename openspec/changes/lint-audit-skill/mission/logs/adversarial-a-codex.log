lt_enabled\": true,\n    86\t      \"rationale\": \"Catches always-true or always-false branches that hide logic mistakes.\"\n    87\t    },\n    88\t    {\n    89\t      \"name\": \"import/no-cycle\",\n    90\t      \"category\": \"imports\",\n    91\t      \"severity\": \"error\",\n    92\t      \"default_enabled\": false,\n    93\t      \"rationale\": \"Prevents circular imports that can produce undefined values at runtime.\"\n    94\t    },\n    95\t    {\n    96\t      \"name\": \"import/named\",\n    97\t      \"category\": \"imports\",\n    98\t      \"severity\": \"error\",\n    99\t      \"default_enabled\": false,\n   100\t      \"rationale\": \"Catches imports and re-exports that reference names a module does not provide.\"\n   101\t    }\n   102\t  ]\n   103\t}\n","exit_code":0,"status":"completed"}}
