{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba install.sh | sed -n '1,220p'\"","aggregated_output":"     1\t#!/bin/sh\n     2\t# Resolve repo root from script location, not a hardcoded path.\n     3\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd -P)\"\n     4\tDARKFACTORY=\"$SCRIPT_DIR\"\n     5\tSKILLS_DIR=\"$DARKFACTORY/skills\"\n     6\tCLAUDE_SKILLS=\"$HOME/.claude/skills\"\n     7\tAGENTS_SKILLS=\"$HOME/.agents/skills\"\n     8\tCODEX_SKILLS=\"$HOME/.codex/skills\"\n     9\t\n    10\tmkdir -p \"$CLAUDE_SKILLS\" \"$AGENTS_SKILLS\" \"$CODEX_SKILLS\"\n    11\t\n    12\tif [ ! -d \"$SKILLS_DIR\" ]; then\n    13\t    echo \"Error: $SKILLS_DIR not found\" >&2\n    14\t    exit 1\n    15\tfi\n    16\t\n    17\tcount=0\n    18\tfor skill_dir in \"$SKILLS_DIR\"/*/; do\n    19\t    [ -d \"$skill_dir\" ] || continue\n    20\t    name=$(basename \"$skill_dir\")\n    21\t    rm -f \"$CLAUDE_SKILLS/$name\" \"$AGENTS_SKILLS/$name\" \"$CODEX_SKILLS/$name\"\n    22\t    ln -sf \"${skill_dir%/}\" \"$CLAUDE_SKILLS/$name\"\n    23\t    ln -sf \"$CLAUDE_SKILLS/$name\" \"$AGENTS_SKILLS/$name\"\n    24\t    ln -sf \"$CLAUDE_SKILLS/$name\" \"$CODEX_SKILLS/$name\"\n    25\t    echo \"linked: $name\"\n    26\t    count=$((count + 1))\n    27\tdone\n    28\t\n    29\tif [ \"$count\" -eq 0 ]; then\n    30\t    echo \"Error: no skills found in $SKILLS_DIR\" >&2\n    31\t    exit 1\n    32\tfi\n    33\t\n    34\techo \"Done. $count skills installed.\"\n","exit_code":0,"status":"completed"}}
