 \"category\": \"type-safety\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": false,\n+      \"rationale\": \"Prevents property access on any-typed values that can fail at runtime.\"\n+    },\n+    {\n+      \"name\": \"typescript/no-floating-promises\",\n+      \"category\": \"error-handling\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": true,\n+      \"rationale\": \"Forces promises to be awaited, returned, or explicitly handled.\"\n+    },\n+    {\n+      \"name\": \"typescript/no-misused-promises\",\n+      \"category\": \"error-handling\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": false,\n+      \"rationale\": \"Catches promises used where a boolean, void callback, or plain value was expected.\"\n+    },\n+    {\n+      \"name\": \"typescript/switch-exhaustiveness-check\",\n+      \"category\": \"code-quality\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": false,\n+      \"rationale\": \"Forces every union case to be handled when switch statements evolve.\"\n+    },\n+    {\n+      \"name\": \"eslint/no-empty\",\n+      \"category\": \"error-handling\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": false,\n+      \"rationale\": \"Prevents empty blocks and catch handlers from hiding unfinished error handling.\"\n+    },\n+    {\n+      \"name\": \"eslint/no-unused-vars\",\n+      \"category\": \"code-quality\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": true,\n+      \"rationale\": \"Catches dead declarations left behind by incomplete edits.\"\n+    },\n+    {\n+      \"name\": \"eslint/no-unused-expressions\",\n+      \"category\": \"code-quality\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": true,\n+      \"rationale\": \"Flags expressions that do nothing and often indicate a mistaken edit.\"\n+    },\n+    {\n+      \"name\": \"eslint/no-constant-condition\",\n+      \"category\": \"code-quality\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": true,\n+      \"rationale\": \"Catches always-true or always-false branches that hide logic mistakes.\"\n+    },\n+    {\n+      \"name\": \"import/no-cycle\",\n+      \"category\": \"imports\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": false,\n+      \"rationale\": \"Prevents circular imports that can produce undefined values at runtime.\"\n+    },\n+    {\n+      \"name\": \"import/named\",\n+      \"category\": \"imports\",\n+      \"severity\": \"error\",\n+      \"default_enabled\": false,\n+      \"rationale\": \"Catches imports and re-exports that reference names a module does not provide.\"\n+    }\n+  ]\n+}\ndiff --git a/skills/lint-audit/tests/validate-rules-json.sh b/skills/lint-audit/tests/validate-rules-json.sh\nnew file mode 100755\nindex 0000000..bdd3a8b\n--- /dev/null\n+++ b/skills/lint-audit/tests/validate-rules-json.sh\n@@ -0,0 +1,41 @@\n+#!/bin/sh\n+set -eu\n+\n+rules_file=\"${1:-skills/lint-audit/rules.json}\"\n+\n+if ! command -v jq >/dev/null 2>&1; then\n+  printf '%s\\n' \"jq is required to validate ${rules_file}\" >&2\n+  exit 1\n+fi\n+\n+jq -e '\n+  def semver: test(\"^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\");\n+  def canonical_rule_name: test(\"^[a-z0-9-]+/[a-z0-9-]+$\");\n+  def allowed_category: IN(\"type-safety\", \"error-handling\", \"code-quality\", \"imports\");\n+  def required_rules: [\n+    \"typescript/no-explicit-any\",\n+    \"typescript/no-non-null-assertion\",\n+    \"typescript/no-floating-promises\",\n+    \"typescript/no-misused-promises\",\n+    \"typescript/switch-exhaustiveness-check\"\n+  ];\n+\n+  (.oxlint_version | type == \"string\" and semver)\n+  and (.rules | type == \"array\" and length >= 8)\n+  and (\n+    .rules\n+    | all(\n+      (.name | type == \"string\" and canonical_rule_name)\n+      and (.category | type == \"string\" and allowed_category)\n+      and (.severity | IN(\"error\", \"warn\"))\n+      and (.default_enabled | type == \"boolean\")\n+      and (.rationale | type == \"string\" and length > 0)\n+    )\n+  )\n+  and ((.rules | map(.name) | length) == (.rules | map(.name) | unique | length))\n+  and (\n+    required_rules as $required\n+    | (.rules | map(.name)) as $actual\n+    | all($required[]; . as $rule | $actual | index($rule))\n+  )\n+' \"$rules_file\" >/dev/null\n","exit_code":0,"status":"completed"}}
