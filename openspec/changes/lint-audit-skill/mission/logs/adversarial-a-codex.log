{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba skills/lint-audit/tests/audit-sh.sh | sed -n '1,260p'\"","aggregated_output":"     1\t#!/bin/sh\n     2\tset -eu\n     3\t\n     4\tscript_dir=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n     5\taudit_sh=$(CDPATH= cd -- \"${script_dir}/..\" && pwd)/audit.sh\n     6\t\n     7\ttmp_root=$(mktemp -d \"${TMPDIR:-/tmp}/lint-audit-test.XXXXXX\")\n     8\ttrap 'rm -rf \"$tmp_root\"' EXIT HUP INT TERM\n     9\t\n    10\tfail() {\n    11\t  printf 'FAIL: %s\\n' \"$1\" >&2\n    12\t  exit 1\n    13\t}\n    14\t\n    15\tassert_jq() {\n    16\t  file=$1\n    17\t  filter=$2\n    18\t  message=$3\n    19\t\n    20\t  jq -e \"$filter\" \"$file\" >/dev/null || fail \"$message\"\n    21\t}\n    22\t\n    23\twrite_package_json() {\n    24\t  project=$1\n    25\t  package_name=$2\n    26\t\n    27\t  mkdir -p \"$project\"\n    28\t  jq -n --arg package_name \"$package_name\" '\n    29\t    {\n    30\t      scripts: {},\n    31\t      devDependencies: {\n    32\t        ($package_name): \"1.0.0\"\n    33\t      }\n    34\t    }\n    35\t  ' >\"${project}/package.json\"\n    36\t}\n    37\t\n    38\twrite_package_json_with_lint_script() {\n    39\t  project=$1\n    40\t  package_name=$2\n    41\t  lint_script=$3\n    42\t\n    43\t  mkdir -p \"$project\"\n    44\t  jq -n --arg package_name \"$package_name\" --arg lint_script \"$lint_script\" '\n    45\t    {\n    46\t      scripts: {\n    47\t        lint: $lint_script\n    48\t      },\n    49\t      devDependencies: {\n    50\t        ($package_name): \"1.0.0\"\n    51\t      }\n    52\t    }\n    53\t  ' >\"${project}/package.json\"\n    54\t}\n    55\t\n    56\trun_audit() {\n    57\t  project=$1\n    58\t  output=$2\n    59\t\n    60\t  \"$audit_sh\" \"$project\" >\"$output\"\n    61\t}\n    62\t\n    63\ttest_oxlint_project_without_config_reports_defaults() {\n    64\t  project=\"${tmp_root}/oxlint-no-config\"\n    65\t  output=\"${tmp_root}/oxlint-no-config.json\"\n    66\t  write_package_json \"$project\" oxlint\n    67\t\n    68\t  run_audit \"$project\" \"$output\"\n    69\t\n    70\t  assert_jq \"$output\" '.outcome == \"ok\"' \"oxlint project should audit\"\n    71\t  assert_jq \"$output\" '.linter == \"oxlint\"' \"oxlint project should report oxlint linter\"\n    72\t  assert_jq \"$output\" '.config_path == null' \"missing oxlint config should report null config path\"\n    73\t  assert_jq \"$output\" '\n    74\t    any(.oxlint_findings[];\n    75\t      .name == \"typescript/no-floating-promises\"\n    76\t      and .status == \"enabled\"\n    77\t    )\n    78\t  ' \"default-enabled rule should be enabled without config\"\n    79\t  assert_jq \"$output\" '\n    80\t    any(.oxlint_findings[];\n    81\t      .name == \"typescript/no-explicit-any\"\n    82\t      and .status == \"missing\"\n    83\t      and (.rationale | length > 0)\n    84\t    )\n    85\t  ' \"non-default rule should be missing without config and include rationale\"\n    86\t}\n    87\t\n    88\ttest_eslint_only_project_skips() {\n    89\t  project=\"${tmp_root}/eslint-only\"\n    90\t  output=\"${tmp_root}/eslint-only.json\"\n    91\t  write_package_json \"$project\" eslint\n    92\t\n    93\t  run_audit \"$project\" \"$output\"\n    94\t\n    95\t  assert_jq \"$output\" '.outcome == \"skip\"' \"eslint-only project should skip\"\n    96\t  assert_jq \"$output\" '.linter == \"eslint\"' \"eslint-only project should report eslint linter\"\n    97\t}\n    98\t\n    99\ttest_project_without_package_json_skips() {\n   100\t  project=\"${tmp_root}/no-package\"\n   101\t  output=\"${tmp_root}/no-package.json\"\n   102\t  mkdir -p \"$project\"\n   103\t\n   104\t  run_audit \"$project\" \"$output\"\n   105\t\n   106\t  assert_jq \"$output\" '.outcome == \"skip\"' \"project without package.json should skip\"\n   107\t  assert_jq \"$output\" '.linter == \"none\"' \"project without package.json should report no linter\"\n   108\t}\n   109\t\n   110\ttest_json_config_reports_enabled_and_disabled_rules() {\n   111\t  project=\"${tmp_root}/json-config\"\n   112\t  output=\"${tmp_root}/json-config.json\"\n   113\t  write_package_json_with_lint_script \"$project\" oxlint \"oxlint --type-aware\"\n   114\t  jq -n '{\n   115\t    rules: {\n   116\t      \"typescript/no-explicit-any\": \"error\",\n   117\t      \"typescript/no-non-null-assertion\": \"off\"\n   118\t    }\n   119\t  }' >\"${project}/.oxlintrc.json\"\n   120\t\n   121\t  run_audit \"$project\" \"$output\"\n   122\t\n   123\t  assert_jq \"$output\" '.outcome == \"ok\"' \"json config project should audit\"\n   124\t  assert_jq \"$output\" '.config_path == \".oxlintrc.json\"' \"json config path should be reported\"\n   125\t  assert_jq \"$output\" '.type_aware == true' \"lint script --type-aware should be detected\"\n   126\t  assert_jq \"$output\" '\n   127\t    any(.oxlint_findings[];\n   128\t      .name == \"typescript/no-explicit-any\"\n   129\t      and .status == \"enabled\"\n   130\t    )\n   131\t  ' \"configured error rule should be enabled\"\n   132\t  assert_jq \"$output\" '\n   133\t    any(.oxlint_findings[];\n   134\t      .name == \"typescript/no-non-null-assertion\"\n   135\t      and .status == \"disabled\"\n   136\t    )\n   137\t  ' \"configured off rule should be disabled\"\n   138\t}\n   139\t\n   140\ttest_tsconfig_missing_strict_reports_migration_scope() {\n   141\t  project=\"${tmp_root}/tsconfig-strict\"\n   142\t  output=\"${tmp_root}/tsconfig-strict.json\"\n   143\t  bin_dir=\"${tmp_root}/bin\"\n   144\t  mkdir -p \"$bin_dir\"\n   145\t  write_package_json \"$project\" oxlint\n   146\t  jq -n '{\n   147\t    compilerOptions: {\n   148\t      strict: false,\n   149\t      noUncheckedIndexedAccess: true\n   150\t    },\n   151\t    files: [\"index.ts\"]\n   152\t  }' >\"${project}/tsconfig.json\"\n   153\t  printf '%s\\n' 'const value = 1;' >\"${project}/index.ts\"\n   154\t  cat >\"${bin_dir}/tsc\" <<'EOF'\n   155\t#!/bin/sh\n   156\tcase \" $* \" in\n   157\t  *\" --showConfig \"*)\n   158\t    printf '%s\\n' '{\"compilerOptions\":{\"strict\":false,\"noUncheckedIndexedAccess\":true},\"files\":[\"./index.ts\"]}'\n   159\t    exit 0\n   160\t    ;;\n   161\t  *\" --strict \"*)\n   162\t    printf '%s\\n' 'index.ts(1,1): error TS7006: Parameter implicitly has an any type.'\n   163\t    printf '%s\\n' 'index.ts(2,1): error TS2322: Type number is not assignable to string.'\n   164\t    exit 2\n   165\t    ;;\n   166\t  *)\n   167\t    exit 0\n   168\t    ;;\n   169\tesac\n   170\tEOF\n   171\t  chmod +x \"${bin_dir}/tsc\"\n   172\t\n   173\t  PATH=\"${bin_dir}:$PATH\" run_audit \"$project\" \"$output\"\n   174\t\n   175\t  assert_jq \"$output\" '\n   176\t    any(.tsconfig_findings[];\n   177\t      .path == \"tsconfig.json\"\n   178\t      and any(.settings[];\n   179\t        .name == \"strict\"\n   180\t        and .status == \"missing\"\n   181\t        and .migration_scope == 2\n   182\t      )\n   183\t    )\n   184\t  ' \"missing strict should include migration scope from tsc errors\"\n   185\t  assert_jq \"$output\" '\n   186\t    any(.tsconfig_findings[];\n   187\t      .path == \"tsconfig.json\"\n   188\t      and any(.settings[];\n   189\t        .name == \"noUncheckedIndexedAccess\"\n   190\t        and .status == \"enabled\"\n   191\t      )\n   192\t    )\n   193\t  ' \"enabled tsconfig setting should be reported\"\n   194\t}\n   195\t\n   196\ttest_oxlint_project_without_config_reports_defaults\n   197\ttest_eslint_only_project_skips\n   198\ttest_project_without_package_json_skips\n   199\ttest_json_config_reports_enabled_and_disabled_rules\n   200\ttest_tsconfig_missing_strict_reports_migration_scope\n   201\t\n   202\tprintf 'audit-sh tests passed\\n'\n","exit_code":0,"status":"completed"}}
